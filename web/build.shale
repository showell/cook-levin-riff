-- web/build.shale: the Nibble playground, built and checked.
--
--   shale web/build.shale      from the repository's root
--
-- 1. web/puzzles.c (gcc -Wall -Wextra -Werror) writes the puzzle table,
--    out/web/puzzles.json, and every program's run on every input,
--    out/web/runs.json, for the check. web/plus_runs.c (the same flags)
--    writes src/plus.c's verdicts on 27,848 Nibble++ programs, every one
--    of 1 to 7 lines and 6,004 longer, to out/web/plus_runs.txt.
--    web/plus_names.c (the same flags) names every Nibble++ language
--    (docs/NIBBLE_PLUS_NAMES.md), out/web/plus_names.tsv, and writes the
--    page's table of the names of cost 4 or less, out/web/plus_names.bin;
--    web/plus_names_check.c parses each name back to its set with an
--    evaluator of its own and holds the table to the tsv. cube/census.c
--    runs on 4 x 4, its report held to cube/golden/census4.txt, and writes
--    every pattern's par and solution, out/web/cube_pars4.txt;
--    web/cube_data.c makes that the cube page's table, out/web/cube_pars.bin
--    (a byte a pattern), and writes cube/cube.c's runs of 400 sample
--    programs, out/web/cube_runs.txt.
-- 2. clang (the system's, --target=wasm32-unknown-unknown) compiles
--    web/platform/host.c, the allocator and the runtime functions Roc
--    calls, to an object, web/platform/targets/wasm32/host.wasm. Then
--    roc/NibbleWasm.roc, the Roc port's Machine.roc on the platform in
--    web/platform, is built by the Roc that roc/roc-version pins
--    (`--target=wasm32 --opt=speed`), which links it with that object into
--    out/web/nibble.wasm, whose exports are the page's `status`, `after`
--    and `accepts` (the platform's `exports:`). roc/PlusWasm.roc, Plus.roc
--    on web/platform/plus.roc (main.roc's twin, the same host.wasm), is
--    built the same way to out/web/plus.wasm, the Nibble++ page's machine,
--    and roc/CubeWasm.roc, Cube.roc on web/platform/cube.roc, to
--    out/web/cube.wasm, the cube page's.
-- 3. The pages, the puzzles (index.html), the sandbox (sandbox.html)
--    the Nibble++ sandbox (plus.html) and the rolling cube (cube.html, and
--    its help, cube_help.html), go to out/web/site, each file but the pages
--    named by its bytes
--    (`nibble.<hash>.js`, the first 16 hex digits of its sha256), as
--    roc-apps' site names them: the wasm, the table, the shared stylesheet
--    nibble.css, the shared module machine.js and each page's script,
--    nibble.js, sandbox.js and plus.js, and plus.js's wasm, plus.wasm, and
--    its names table, plus_names.bin, and cube.js with cube.wasm,
--    cube_pars.bin and the same names table. Each
--    name a file holds is rewritten to its hashed one before that file is
--    hashed: machine.js's wasm and table, plus.js's and cube.js's wasm and
--    tables, the two Nibble
--    scripts' import of machine.js, the pages' script and stylesheet.
-- 4. web/page_check.mjs holds the wasm to the C's table on all 4,096 x 4
--    runs and to its 16-puzzle table and order, then loads the page in
--    headless Chromium at 390px, solves the first puzzle by clicking, sees
--    nothing scroll sideways, the locked and fixed lines locked, and a
--    reload start fresh with nothing stored, solves the other three lessons
--    by one click each, and opens and solves puzzles 5 to 16 by clicks, each
--    with its fixed zero; then it loads the sandbox and plays it by clicks
--    and by a typed program number. It holds plus.wasm to
--    out/web/plus_runs.txt, every input and every step, and plays the
--    Nibble++ sandbox, 7 fixed lines: its start, #6554 deciding {0, 1, 2},
--    clicked edits and the languages' names (from out/web/plus_names.tsv),
--    the fallback for one without, its "?", and none of the controls the
--    lean page dropped.
--    It saves screenshots to out/web/page.png,
--    out/web/page-given.png, out/web/page-fixed.png,
--    out/web/page-sandbox.png and out/web/page-plus.png.
-- 5. web/cube_check.mjs holds cube.wasm to cube.c on the 400 sample runs,
--    frame by frame, rolls every census solution through it, holds
--    cube_pars.bin and L to the census, and plays cube.html in headless
--    Chromium: halting, L, clicks on the tiles, the lit set's names (held
--    to out/web/plus_names.tsv), the listing's lines and opcodes, the glow,
--    the compass and the landings, three panes with no scroll at 1366 x 650
--    and 1920 x 700, one column at a phone's width, and the help page;
--    screenshots out/web/cube.png, cube-rolling.png, cube-halt.png,
--    cube-glow.png, cube-landing.png, cube-wide.png and cube-phone.png.
--
-- One line a stage. Exits 0 only when every check passes.

const OUT = "out/web"
const SITE = "out/web/site"
-- Where main.roc's `inputs_dir` finds host.wasm (ignored by git).
const HOST_DIR = "web/platform/targets/wasm32"
const RAN = "build: the table program this build just compiled"
const WANT_ROC = "roc-pin: the Roc port's pinned compiler"
const WANT_NODE = "node: the page check, in headless Chromium"

-- The first 16 hex digits of the file's sha256.
function hash_of(path)
  local r = must(run({"sha256sum", real(path)}, {timeout_ms = 60000, whole = 400}))
  return sub(r.out, 1, 16)
end

-- The hashed name of OUT's `name.ext`, `name.<hash>.ext`.
function hashed_name(name, ext)
  return name .. "." .. hash_of(OUT .. "/" .. name .. "." .. ext) .. "." .. ext
end

-- `text` with `old` put as `new`; a name that isn't there stops the build,
-- so no rewrite misses quietly.
function rename_in(text, old, new, file)
  if not contains(text, old) then fail("web/build.shale: " .. file .. " holds no " .. old) end
  return substitute(text, old, new)
end

-- `web/<name>.<ext>`, each `{old, new}` of `swaps` rewritten, written to OUT
-- and copied to SITE by its hashed name, which it gives.
function hashed_copy(name, ext, swaps)
  local file = name .. "." .. ext
  local text = read("web/" .. file)
  for s in swaps do text = rename_in(text, s[1], s[2], "web/" .. file) end
  replace(OUT .. "/" .. file, text)
  local hashed = hashed_name(name, ext)
  copy(OUT .. "/" .. file, SITE .. "/" .. hashed)
  return hashed
end

-- The Roc roc/roc-version pins, ~/tools/roc-<pin>/roc, held to its version
-- (roc/check.shale's check).
function pinned_roc()
  local pin = trim(read("roc/roc-version"))
  local roc = "tools:roc-" .. pin .. "/roc"
  if not exists(roc) then fail("web/build.shale: no " .. roc .. ": install the pinned Roc " .. pin .. " at ~/tools/roc-" .. pin .. "/") end
  local said = run({real(roc), "version"}, {timeout_ms = 30000, whole = 4000, want = WANT_ROC})
  if trim(said.out) ~= "Roc compiler version " .. pin then fail("web/build.shale: " .. roc .. " is " .. trim(said.out) .. ", not " .. pin) end
  return real(roc)
end

mkdir(OUT)
local cc = must(run({"gcc", "-std=c11", "-O2", "-Wall", "-Wextra", "-Werror", "-o", real(OUT) .. "/puzzles", "web/puzzles.c"},
  {timeout_ms = 120000, tail = 20}))
local table = must(run({real(OUT .. "/puzzles"), "puzzles"}, {timeout_ms = 10000, whole = 16000, want = RAN}))
replace(OUT .. "/puzzles.json", table.out)
local runs = must(run({real(OUT .. "/puzzles"), "runs"}, {timeout_ms = 10000, whole = 20000, want = RAN}))
replace(OUT .. "/runs.json", runs.out)
local puzzles = json_read(table.out).puzzles
print("ok   web/puzzles.c: " .. #puzzles .. " puzzles, " .. (#runs.out - 3) .. " runs, " .. cc.ms .. " ms to compile")
must(run({"gcc", "-std=c11", "-O2", "-Wall", "-Wextra", "-Werror", "-o", real(OUT) .. "/plus_runs", "web/plus_runs.c"},
  {timeout_ms = 120000, tail = 20}))
must(run({real(OUT .. "/plus_runs"), real(OUT) .. "/plus_runs.txt"}, {timeout_ms = 30000, tail = 10, want = RAN}))
print("ok   web/plus_runs.c: " .. count_lines(OUT .. "/plus_runs.txt") .. " Nibble++ programs judged by src/plus.c")
must(run({"gcc", "-std=c11", "-O2", "-Wall", "-Wextra", "-Werror", "-o", real(OUT) .. "/plus_names", "web/plus_names.c"},
  {timeout_ms = 120000, tail = 20}))
local named = must(run({real(OUT .. "/plus_names"), real(OUT) .. "/plus_names.tsv", real(OUT) .. "/plus_names.bin"},
  {timeout_ms = 60000, tail = 20, want = RAN, cpu_budget_ms = 5000, stage = "plus_names"}))
must(run({"gcc", "-std=c11", "-O2", "-Wall", "-Wextra", "-Werror", "-o", real(OUT) .. "/plus_names_check", "web/plus_names_check.c"},
  {timeout_ms = 120000, tail = 20}))
local checked = must(run({real(OUT .. "/plus_names_check"), real(OUT .. "/plus_names.tsv"), real(OUT .. "/plus_names.bin"), "4"},
  {timeout_ms = 60000, tail = 20, want = RAN}))
local coverage = {}
for l in lines(trim(checked.out)) do
  if starts_with(l, "cost ") or starts_with(l, "none") then push(coverage, l) end
end
print("ok   web/plus_names.c: " .. named.ms .. " ms; plus_names_check: " .. join(coverage, ", ") .. "; plus_names.bin " .. stat(OUT .. "/plus_names.bin").size .. " bytes, the names of cost 4 or less")

-- The cube page's data: the census on 4 x 4, its report held to its golden,
-- its every pattern's par and solution made the page's table, and cube.c's
-- runs of web/cube_data.c's sample for the check.
must(run({"gcc", "-std=c11", "-O2", "-Wall", "-Wextra", "-Werror", "-o", real(OUT) .. "/census", "cube/census.c"},
  {timeout_ms = 120000, tail = 20}))
local census = must(run({real(OUT .. "/census"), "4", real(OUT) .. "/cube_pars4.txt"},
  {timeout_ms = 120000, whole = 65536, want = RAN, cpu_budget_ms = 10000, stage = "cube census 4"}))
if census.out ~= read("cube/golden/census4.txt") then fail("web/build.shale: census 4's report is not cube/golden/census4.txt") end
must(run({"gcc", "-std=c11", "-O2", "-Wall", "-Wextra", "-Werror", "-o", real(OUT) .. "/cube_data", "web/cube_data.c"},
  {timeout_ms = 120000, tail = 20}))
local cube_pars = must(run({real(OUT .. "/cube_data"), "pars", real(OUT .. "/cube_pars4.txt"), real(OUT) .. "/cube_pars.bin"},
  {timeout_ms = 60000, tail = 5, want = RAN}))
must(run({real(OUT .. "/cube_data"), "runs", real(OUT) .. "/cube_runs.txt"}, {timeout_ms = 60000, tail = 5, want = RAN}))
print("ok   cube/census.c 4: " .. census.ms .. " ms, its report cube/golden/census4.txt; " .. trim(cube_pars.out) .. "; cube_pars.bin " .. stat(OUT .. "/cube_pars.bin").size .. " bytes; " .. count_lines(OUT .. "/cube_runs.txt") .. " sample runs by cube/cube.c")

-- Bulk memory makes host.c's memcpy a memory.copy, not an import.
mkdir(HOST_DIR)
if exists(HOST_DIR .. "/host.wasm") then remove(HOST_DIR .. "/host.wasm") end
local h = must(run({"clang", "--target=wasm32-unknown-unknown", "-mbulk-memory", "-O2", "-std=c11", "-Wall", "-Wextra", "-Werror",
  "-c", "web/platform/host.c", "-o", real(HOST_DIR) .. "/host.wasm"},
  {timeout_ms = 120000, tail = 20}))

local roc = pinned_roc()
local wasm_out = real(OUT) .. "/nibble.wasm"
if exists(OUT .. "/nibble.wasm") then remove(OUT .. "/nibble.wasm") end
local b = run({roc, "build", "NibbleWasm.roc", "--target=wasm32", "--opt=speed", "--output=" .. wasm_out},
  {cwd = "roc", timeout_ms = 600000, tail = 40, nice = 10, want = WANT_ROC})
if b.code ~= 0 or contains(b.out, "✗") or contains(b.out, "●") or not exists(OUT .. "/nibble.wasm") then
  print(trim(b.out))
  fail("roc build roc/NibbleWasm.roc exited " .. b.code)
end
print("ok   clang web/platform/host.c: " .. h.ms .. " ms; roc build roc/NibbleWasm.roc --opt=speed: " .. b.ms .. " ms; nibble.wasm " .. #read(OUT .. "/nibble.wasm") .. " bytes")
if exists(OUT .. "/plus.wasm") then remove(OUT .. "/plus.wasm") end
local pb = run({roc, "build", "PlusWasm.roc", "--target=wasm32", "--opt=speed", "--output=" .. real(OUT) .. "/plus.wasm"},
  {cwd = "roc", timeout_ms = 600000, tail = 40, nice = 10, want = WANT_ROC})
if pb.code ~= 0 or contains(pb.out, "✗") or contains(pb.out, "●") or not exists(OUT .. "/plus.wasm") then
  print(trim(pb.out))
  fail("roc build roc/PlusWasm.roc exited " .. pb.code)
end
print("ok   roc build roc/PlusWasm.roc --opt=speed: " .. pb.ms .. " ms; plus.wasm " .. #read(OUT .. "/plus.wasm") .. " bytes")
if exists(OUT .. "/cube.wasm") then remove(OUT .. "/cube.wasm") end
local cb = run({roc, "build", "CubeWasm.roc", "--target=wasm32", "--opt=speed", "--output=" .. real(OUT) .. "/cube.wasm"},
  {cwd = "roc", timeout_ms = 600000, tail = 40, nice = 10, want = WANT_ROC})
if cb.code ~= 0 or contains(cb.out, "✗") or contains(cb.out, "●") or not exists(OUT .. "/cube.wasm") then
  print(trim(cb.out))
  fail("roc build roc/CubeWasm.roc exited " .. cb.code)
end
print("ok   roc build roc/CubeWasm.roc --opt=speed: " .. cb.ms .. " ms; cube.wasm " .. #read(OUT .. "/cube.wasm") .. " bytes")

if exists(SITE) then remove_tree(SITE) end
mkdir(SITE)
local wasm = hashed_name("nibble", "wasm")
copy(OUT .. "/nibble.wasm", SITE .. "/" .. wasm)
local json = hashed_name("puzzles", "json")
copy(OUT .. "/puzzles.json", SITE .. "/" .. json)
local shared = hashed_copy("machine", "js", {{"fetch(\"nibble.wasm\")", "fetch(\"" .. wasm .. "\")"},
  {"fetch(\"puzzles.json\")", "fetch(\"" .. json .. "\")"}})
local css = hashed_copy("nibble", "css", {})
local import = {"from \"./machine.js\"", "from \"./" .. shared .. "\""}
local js = hashed_copy("nibble", "js", {import})
local sandbox_js = hashed_copy("sandbox", "js", {import})
local plus_wasm = hashed_name("plus", "wasm")
copy(OUT .. "/plus.wasm", SITE .. "/" .. plus_wasm)
local plus_names = hashed_name("plus_names", "bin")
copy(OUT .. "/plus_names.bin", SITE .. "/" .. plus_names)
local plus_js = hashed_copy("plus", "js", {{"fetched(\"plus.wasm\")", "fetched(\"" .. plus_wasm .. "\")"},
  {"fetched(\"plus_names.bin\")", "fetched(\"" .. plus_names .. "\")"}})
local sheet = {"href=\"nibble.css\"", "href=\"" .. css .. "\""}
replace(SITE .. "/index.html", rename_in(rename_in(read("web/index.html"), "src=\"nibble.js\"", "src=\"" .. js .. "\"", "web/index.html"),
  sheet[1], sheet[2], "web/index.html"))
replace(SITE .. "/sandbox.html", rename_in(rename_in(read("web/sandbox.html"), "src=\"sandbox.js\"", "src=\"" .. sandbox_js .. "\"", "web/sandbox.html"),
  sheet[1], sheet[2], "web/sandbox.html"))
replace(SITE .. "/plus.html", rename_in(rename_in(read("web/plus.html"), "src=\"plus.js\"", "src=\"" .. plus_js .. "\"", "web/plus.html"),
  sheet[1], sheet[2], "web/plus.html"))
local cube_wasm = hashed_name("cube", "wasm")
copy(OUT .. "/cube.wasm", SITE .. "/" .. cube_wasm)
local cube_bin = hashed_name("cube_pars", "bin")
copy(OUT .. "/cube_pars.bin", SITE .. "/" .. cube_bin)
local cube_js = hashed_copy("cube", "js", {{"fetched(\"cube.wasm\")", "fetched(\"" .. cube_wasm .. "\")"},
  {"fetched(\"cube_pars.bin\")", "fetched(\"" .. cube_bin .. "\")"}, {"fetched(\"plus_names.bin\")", "fetched(\"" .. plus_names .. "\")"}})
replace(SITE .. "/cube.html", rename_in(rename_in(read("web/cube.html"), "src=\"cube.js\"", "src=\"" .. cube_js .. "\"", "web/cube.html"),
  sheet[1], sheet[2], "web/cube.html"))
replace(SITE .. "/cube_help.html", rename_in(read("web/cube_help.html"), sheet[1], sheet[2], "web/cube_help.html"))
print("ok   " .. SITE .. ": index.html, sandbox.html, plus.html, cube.html, cube_help.html, " .. join({js, sandbox_js, plus_js, cube_js, shared, css, wasm, plus_wasm, plus_names, json, cube_wasm, cube_bin}, ", "))

local check = run({"node", "web/page_check.mjs", real(SITE), real(OUT .. "/puzzles.json"), real(OUT .. "/runs.json"), real(OUT .. "/plus_runs.txt"), real(OUT) .. "/page.png", real(OUT .. "/plus_names.tsv")},
  {timeout_ms = 120000, tail = 30, want = WANT_NODE})
print(trim(check.out))
if check.code ~= 0 then fail("web/page_check.mjs exited " .. check.code) end

local cube_check = run({"node", "web/cube_check.mjs", real(SITE), real(OUT .. "/cube_runs.txt"), real(OUT .. "/cube_pars4.txt"), real("cube/golden/census4.txt"), real(OUT) .. "/cube.png", real(OUT .. "/plus_names.tsv")},
  {timeout_ms = 120000, tail = 30, want = WANT_NODE})
print(trim(cube_check.out))
if cube_check.code ~= 0 then fail("web/cube_check.mjs exited " .. cube_check.code) end
