-- build.shale: the builds and every test, in two tiers.
--
--   shale build.shale          the fast tier: tcc runs every test file and
--                              the main program, the program's stdout held
--                              to tests/golden/find_solutions.txt, and
--                              python3 runs the book's Python,
--                              python/decides.py, python/steps.py and
--                              python/fourteen_cnf.py, each of which
--                              checks itself, and python/equations.py
--                              evaluates the decider's equations, as
--                              circuit_main prints them, on every program
--                              and want register; the equations are held
--                              to roc/golden/equations.txt, which the Roc
--                              port's CNF expects read; python/distribute.py
--                              expands them into CNF by distribution and
--                              checks that CNF on every point.
--                              The Nibble++ census, src/census_main.c, is
--                              held to tests/golden/census.txt, and so is
--                              python/census4.py's output, an oracle that
--                              shares no code with the C, and
--                              tests/test_theory_plus.c holds the
--                              recursion of docs/NIBBLE_PLUS_THEORY.md to
--                              that census. sat/plus.shale
--                              runs rocsat on Nibble++'s CNF, its claims
--                              and cheap search cases, and its verdicts
--                              are held to sat/plus/verdicts.txt; it needs
--                              rocsat built at build:rocsat/src/rocsat.
--                              The rolling cube's census, cube/census.c,
--                              is held to cube/golden/census3.txt and
--                              census4.txt, and cube/oracle.py checks
--                              its every par and solution by two
--                              searches and a simulator of its own.
--                              cube/complexity.c holds those pars to
--                              the Hamiltonian lemma, and the 3 x 3
--                              state graph to its diameter
--                              (cube/COMPLEXITY.md), each report held to
--                              cube/golden/complexity3.txt and 4.txt.
--                              sat/check_readable.shale round-trips
--                              every committed CNF and model in sat/
--                              through the readable form, and holds the
--                              planted malformed ones to their stops.
--   shale build.shale full=1   the fast tier, then gcc twice: -std=c11 -O2
--                              -Wall -Wextra -Werror, and -O0 with
--                              -fsanitize=address,undefined; each builds and
--                              runs every test file and the main program,
--                              and the golden check runs on each binary.
--
-- One line a check, with its numbers. Each test file's printed count is held
-- to its `TEST(` count. Exits 0 only when every check passes.
-- The C is a unity build: a test file includes the .c files it needs.
--
-- Run from the repository's root.

const OUT = "out"
const TESTS = {"tests/test_vm.c", "tests/test_reference.c", "tests/test_golden.c", "tests/test_ring_int.c", "tests/test_poly.c", "tests/test_stepper.c", "tests/test_cross_check.c", "tests/test_boolring.c", "tests/test_compose.c", "tests/test_sat.c", "tests/test_drat.c", "tests/test_theorems.c", "tests/test_boolean.c", "tests/test_circuit.c", "tests/test_census.c", "tests/test_plus_sat.c", "tests/test_theory_plus.c"}
-- The command lines the oracles and the book run, compiled in each tier.
const CLIS = {"src/sat_main.c", "src/drat_main.c", "src/boolean_main.c", "src/sat_hand_main.c", "src/circuit_main.c", "src/plus_sat_main.c"}
const GOLDEN = "tests/golden/find_solutions.txt"
const CENSUS_GOLDEN = "tests/golden/census.txt"
const EQUATIONS_GOLDEN = "roc/golden/equations.txt"
-- Why `run` may start a binary git does not track: this build just made it.
const RAN = "build: a test binary this build just compiled"
-- The book's Python, and why `run` may start python3 for it.
const PYTHON = {"python/decides.py", "python/steps.py", "python/fourteen_cnf.py"}
const PYTHON_WANT = "build: the book's Python checks itself"
const GCC_WARN = {"-std=c11", "-Wall", "-Wextra", "-Werror"}

-- Says a check's line; gives 1 when it failed, else 0.
function check(ok, line)
  if ok then
    print("ok   " .. line)
    return 0
  end
  print("FAIL " .. line)
  return 1
end

-- A program killed by a signal (an abort) has no exit code.
function exited_0(r)
  return get(r, "code", -1) == 0
end

function how_it_ended(r)
  if has_key(r, "code") then return "exit " .. r.code end
  return "ended " .. r.ended
end

function test_count(src)
  local n = 0
  for m in grep(src, "TEST(") do
    if starts_with(m.text, "TEST(") then n = n + 1 end
  end
  return n
end

-- The compile command of `src` to `bin` for a build.
function compile_argv(build, src, bin)
  local argv = {}
  if build == "tcc" then
    argv = {"tcc", "-Wall", "-Werror"}
  elseif build == "release" then
    argv = {"gcc", "-O2"}
    for w in GCC_WARN do push(argv, w) end
  else
    argv = {"gcc", "-O0", "-g", "-fsanitize=address,undefined", "-fno-sanitize-recover=all"}
    for w in GCC_WARN do push(argv, w) end
  end
  push(argv, "-o")
  push(argv, bin)
  push(argv, src)
  return argv
end

-- Compiles `src`; gives the binary's Shale path, or nil (said) when it fails.
function compiled(build, src)
  local name = sub(basename(src), 1, #basename(src) - 2)
  local bin = OUT .. "/" .. build .. "/" .. name
  local r = run(compile_argv(build, src, real(bin)), {timeout_ms = 120000, tail = 20})
  if r.code ~= 0 then
    check(false, build .. ": " .. src .. " does not compile")
    print(r.out)
    return nil
  end
  return bin
end

function run_tests(build, src)
  local bin = compiled(build, src)
  if bin == nil then return 1 end
  local want = test_count(src)
  local r = run({real(bin)}, {timeout_ms = 60000, tail = 30, env = {ASAN_OPTIONS = "detect_leaks=1"}, want = RAN})
  local said = src .. ": " .. want .. " tests passed"
  local ok = exited_0(r) and find(r.out, said) ~= nil
  local bad = check(ok, build .. ": " .. src .. ": " .. want .. " tests, " .. r.ms .. " ms")
  if not exited_0(r) then print("     " .. how_it_ended(r)) end
  if not ok then print(r.out) end
  return bad
end

function run_golden(build)
  local bin = compiled(build, "src/main.c")
  if bin == nil then return 1 end
  local r = run({real(bin)}, {timeout_ms = 60000, whole = 65536, want = RAN})
  local want = read(GOLDEN)
  local same = exited_0(r) and r.out == want
  return check(same, build .. ": main's stdout is " .. GOLDEN .. ": " .. #r.out .. " bytes of " .. #want .. ", " .. how_it_ended(r))
end

-- The Nibble++ census, held to its golden.
function run_census(build)
  local bin = compiled(build, "src/census_main.c")
  if bin == nil then return 1 end
  local r = run({real(bin)}, {timeout_ms = 60000, whole = 65536, want = RAN})
  local want = read(CENSUS_GOLDEN)
  local same = exited_0(r) and r.out == want
  return check(same, build .. ": census_main's stdout is " .. CENSUS_GOLDEN .. ": " .. #r.out .. " bytes of " .. #want .. ", " .. r.ms .. " ms, " .. how_it_ended(r))
end

-- The rolling cube's census on 3 x 3 and 4 x 4, its report held to its
-- golden and its pars written for cube/oracle.py.
function run_cube(build)
  local bin = compiled(build, "cube/census.c")
  if bin == nil then return 1 end
  local bad = 0
  for n in {3, 4} do
    local pars = OUT .. "/" .. build .. "/cube_pars" .. n .. ".txt"
    local r = run({real(bin), "" .. n, real(pars)}, {timeout_ms = 120000, whole = 65536, want = RAN})
    local golden = "cube/golden/census" .. n .. ".txt"
    local want = read(golden)
    bad = bad + check(exited_0(r) and r.out == want, build .. ": cube census " .. n .. "'s stdout is " .. golden .. ": " .. #r.out .. " bytes of " .. #want .. ", " .. r.ms .. " ms, " .. how_it_ended(r))
  end
  return bad
end

local failures = 0
local builds = {"tcc"}
if arg("full", false) then builds = {"tcc", "release", "asan"} end

for build in builds do
  mkdir(OUT .. "/" .. build)
  for src in TESTS do failures = failures + run_tests(build, src) end
  for src in CLIS do
    if compiled(build, src) == nil then
      failures = failures + 1
    else
      check(true, build .. ": " .. src .. " compiles")
    end
  end
  failures = failures + run_golden(build)
  failures = failures + run_census(build)
  failures = failures + run_cube(build)
end

-- The cube's census once more, by Python that shares no code with the C:
-- every par and solution the tier's first census wrote.
for n in {3, 4} do
  local pars = OUT .. "/" .. builds[1] .. "/cube_pars" .. n .. ".txt"
  local py = run({"python3", "cube/oracle.py", "" .. n, real(pars)}, {timeout_ms = 120000, tail = 10, want = PYTHON_WANT, nice = 10})
  local said = trim(py.out)
  local want_said = "cube/oracle.py: 4x4: 65536 solutions rolled, 60760 rolled again past a halt, 65536 pars by 1 search, with halting and without"
  if n == 3 then want_said = "cube/oracle.py: 3x3: 512 solutions rolled, 437 rolled again past a halt, 512 pars by 2 searches, with halting and without" end
  failures = failures + check(exited_0(py) and said == want_said, "python3: cube " .. n .. ": " .. said .. ", " .. py.ms .. " ms, " .. how_it_ended(py))
end

-- The cube's complexity checks (cube/COMPLEXITY.md): the Hamiltonian lemma
-- against every par the tier's first census wrote, the 3 x 3 state graph
-- and its diameter, and the sets with one dark tile, each report held to
-- its golden; then a par planted one over the floor must be refused.
local complexity = compiled(builds[1], "cube/complexity.c")
if complexity == nil then
  failures = failures + 1
else
  for n in {3, 4} do
    local pars = OUT .. "/" .. builds[1] .. "/cube_pars" .. n .. ".txt"
    local r = run({real(complexity), "" .. n, real(pars)}, {timeout_ms = 60000, whole = 65536, want = RAN})
    local golden = "cube/golden/complexity" .. n .. ".txt"
    failures = failures + check(exited_0(r) and r.out == read(golden), builds[1] .. ": cube complexity " .. n .. "'s stdout is " .. golden .. ": " .. #r.out .. " bytes of " .. #read(golden) .. ", " .. r.ms .. " ms, " .. how_it_ended(r))
  end
  -- c1 alone (pattern 4) meets the floor at par 2; planted at 3, the lemma
  -- must find it a counterexample.
  local planted = OUT .. "/" .. builds[1] .. "/cube_pars3_planted.txt"
  replace(planted, read(OUT .. "/" .. builds[1] .. "/cube_pars3.txt"))
  edit(planted, "\n4 2 EE\n", "\n4 3 EE\n")
  local p = run({real(complexity), "3", real(planted)}, {timeout_ms = 60000, whole = 65536, want = RAN})
  failures = failures + check(get(p, "code", -1) == 1 and find(p.out, "COUNTEREXAMPLE: par 3, floor 2, Hamiltonian path from c1 or a3: yes") ~= nil, builds[1] .. ": cube complexity refuses c1 alone planted at par 3, " .. how_it_ended(p))
end

for file in PYTHON do
  local py = run({"python3", file}, {timeout_ms = 60000, tail = 10, want = PYTHON_WANT})
  local py_said = trim(py.out)
  local said_its_checks = starts_with(py_said, file .. ": ") and re_find(py_said, "^[a-z/_.]+: [0-9]+ checks passed$") ~= nil
  failures = failures + check(exited_0(py) and said_its_checks, "python3: " .. py_said .. ", " .. how_it_ended(py))
end

-- The census once more, by Python that shares no code with the C.
local census_py = run({"python3", "python/census4.py"}, {timeout_ms = 120000, whole = 65536, want = PYTHON_WANT, nice = 10})
failures = failures + check(exited_0(census_py) and census_py.out == read(CENSUS_GOLDEN), "python3: python/census4.py's stdout is " .. CENSUS_GOLDEN .. ": " .. #census_py.out .. " bytes, " .. census_py.ms .. " ms, " .. how_it_ended(census_py))

-- The decider's equations, printed by the tier's first circuit_main and
-- read back by Python that shares no code with it.
local eq = run({real(OUT .. "/" .. builds[1] .. "/circuit_main"), "equations"}, {timeout_ms = 60000, whole = 400000, want = RAN})
if exited_0(eq) then
  replace(OUT .. "/equations.txt", eq.out)
  -- roc/ClaimCnf.roc's expects read the equations from this golden.
  failures = failures + check(eq.out == read(EQUATIONS_GOLDEN), "circuit_main equations is " .. EQUATIONS_GOLDEN .. ": " .. #eq.out .. " bytes of " .. #read(EQUATIONS_GOLDEN))
  local py = run({"python3", "python/equations.py", real(OUT .. "/equations.txt")}, {timeout_ms = 60000, tail = 10, want = PYTHON_WANT})
  local said = trim(py.out)
  failures = failures + check(exited_0(py) and said == "python/equations.py: 65536 checks passed", "python3: " .. said .. ", " .. how_it_ended(py))
  local dist = run({"python3", "python/distribute.py", real(OUT .. "/equations.txt")}, {timeout_ms = 120000, tail = 10, want = PYTHON_WANT, nice = 10})
  local dist_said = trim(dist.out)
  failures = failures + check(exited_0(dist) and dist_said == "python/distribute.py: 65536 checks passed", "python3: " .. dist_said .. ", " .. dist.ms .. " ms, " .. how_it_ended(dist))
else
  failures = failures + check(false, "circuit_main equations: " .. how_it_ended(eq))
end

-- rocsat on Nibble++'s CNF: the claims and the cheap search cases, each
-- answer checked by the script, its verdicts held to the committed file.
local plus_held = read("sat/plus/verdicts.txt")
local plus = run({"shale", "sat/plus.shale"}, {timeout_ms = 120000, tail = 20, nice = 10})
local plus_now = read("sat/plus/verdicts.txt")
failures = failures + check(exited_0(plus) and plus_now == plus_held, "sat/plus.shale: rocsat's verdicts are sat/plus/verdicts.txt: " .. #plus_now .. " bytes of " .. #plus_held .. ", " .. plus.ms .. " ms, " .. how_it_ended(plus))
if not exited_0(plus) then print(plus.out) end

-- The readable form of DIMACS, both ways, on every committed CNF and model.
local readable = run({"shale", "sat/check_readable.shale"}, {timeout_ms = 60000, tail = 20})
-- Its last line is its verdict; the first says the budget its header raises.
local readable_lines = lines(trim(readable.out))
local readable_said = get(readable_lines, #readable_lines, "")
failures = failures + check(exited_0(readable) and re_find(readable_said, "^sat/check_readable.shale: .* checks passed$") ~= nil, readable_said .. ", " .. readable.ms .. " ms, " .. how_it_ended(readable))

if failures > 0 then fail(failures .. " check(s) failed") end
print("all checks passed: " .. join(builds, ", "))
