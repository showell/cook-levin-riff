-- budget: steps=20000000 arena_bytes=400000000 read_bytes=100000000 output_bytes=200000
-- This builds the Cook-Levin book, A riff on Cook-Levin, with the book
-- builder (roc-apps' book_builder/), into the dev channel's /cook-levin/:
--
--   cd <cook-levin checkout> && shale book/book.shale
--
-- The book builder is roc-apps', in the roc-apps checkout beside this one
-- (ROC_APPS), and its tools run with that checkout as their root, so they
-- name this checkout's files through its mount (HERE): this script runs from
-- the checkout at HERE alone, and stops elsewhere. The book is the app
-- book/app/main.roc (APP_DIR) on the book platform, which reads this
-- checkout from its root and prints every page. First every commit the
-- manuscript cites is held to resolve (check_citations, below). Its pre-step
-- draws each ```dot fence of the manuscript with Graphviz
-- (book_builder/tools/draw_diagrams.shale) into book/build/prepared/, as
-- diagram-N.dot and diagram-N.svg, where the app reads them. Then it builds
-- src/compose_main.c with gcc -O2 and runs it in book/build/ (COMPOSED), which
-- writes the four final polynomials to book/build/out/, for the chapter that
-- shows them in full; its term counts, degrees and largest coefficients are
-- held to roc/golden/composition.txt first. Then it builds src/sat_main.c
-- and src/drat_main.c with gcc -O2 into book/build/sat/ (SAT_DIR) and checks
-- rocsat's committed outputs, sat/proofs/ (sat/oracle.shale writes them),
-- with no rocsat: each DRAT proof against the CNF sat_main writes for it,
-- by drat_main's checker, and each answer's `v` lines against its CNF's
-- clauses and its program on the machine (`sat solves`). The chapter that
-- shows them is held to what this finds: each proof's row of its table, the
-- checker's line for each proof it shows, and each shown answer's program.
-- The chapter "From equations to CNF" is held to python/distribute.py's
-- sizes and to sat/claims.shale's verdicts (check_cnf), "The SAT
-- solver" to sat/intro.shale's (check_intro), and "Nibble++ meets rocsat"
-- to sat/plus/'s answers, src/plus_sat_main.c's sizes and the census, and
-- "Guided search" to sat/plus/guided.txt (check_plus_sat).
--
-- Then the book builder's tools/build_book.shale runs the app's expects, held
-- to exactly APP_TESTS, builds the app into book_builder/zig-out/cook-levin,
-- on Roc's dev backend, and runs the program on the checkout's root, which
-- writes the pages, or stops on a gate. The pages go to book/build/book/
-- with the builder's stylesheet, and are staged in the channel's
-- /cook-levin.staging/. The builder's tools/book_check.mjs drives them there
-- in a real browser and leaves a shot of each page in book/build/shots/.
-- Then the book builder's tools/move_stage.shale puts the stage in the place
-- of /cook-levin/. A failure at any step stops the run before the move, so
-- the channel's book is left as it was.
const APP_DIR = "book"
const SOURCE = "book/book.md"
const PREPARED = "book/build/prepared"
const OUT = "book/build/book"
const REPORT = "book/build/report.txt"
const SHOTS = "book/build/shots"
const NEXT = "build:roc-apps/next"
const DEST_NAME = "cook-levin"
const STAGED_NAME = "cook-levin.staging"
const ROC_APPS = "repos:roc-apps"
const HERE = "repos:cook-levin"
const DRAW = "book_builder/tools/draw_diagrams.shale"
const MOVE = "book_builder/tools/move_stage.shale"
const CHECKER = "book_builder/tools/book_check.mjs"
const BUILD = "book_builder/tools/build_book.shale"
const APP_TESTS = 17
const DOT_WANT = "graphviz: a book's diagrams, drawn at build time"
const CHECK_WANT = "script: book_check.mjs drives the staged pages in headless Chromium"
const COMPOSED = "book/build"
const COMPOSITION_GOLDEN = "roc/golden/composition.txt"
const COMPOSE_WANT = "book: compose_main, just built from src/ for the book"
const SAT_DIR = "book/build/sat"
const PROOFS = "sat/proofs"
const SAT_WANT = "book: sat_main and drat_main, just built from src/ for the book"
const OPS = {"nada", "zero", "decr", "mod2"}
const CIRCUIT_BLOCKS = 11
const CIRCUIT_SCHEMATICS = 7
const EQUATIONS = "book/build/equations.txt"
const SCHEMATICS = "book/build/schematics"
const PLUS_SEARCH = "sat/plus/search.txt"
const PLUS_VERDICTS = "sat/plus/verdicts.txt"
const PLUS_GUIDED = "sat/plus/guided.txt"
const WALKTHROUGH_BLOCKS = 7

-- The four final polynomials, composed by the C into COMPOSED/out/. What
-- compose_main prints is held to the golden's lines: each step's term counts
-- (its time left off) and each final polynomial's terms, degree and largest
-- coefficient.
function compose_polynomials()
  mkdir(COMPOSED .. "/out")
  local exe = COMPOSED .. "/compose_main"
  must(run({"gcc", "-O2", "-o", real(COMPOSED) .. "/compose_main", "src/compose_main.c"}, {timeout_ms = 120000, tail = 20}))
  local r = must(run({real(exe)}, {cwd = COMPOSED, timeout_ms = 60000, tail = 20, want = COMPOSE_WANT}))
  local said = {}
  for l in lines(r.out) do
    local row = re_find(l, "^([0-9]+  [0-9]+  [0-9]+  [0-9]+  [0-9]+)  [0-9.]+$")
    if row ~= nil then push(said, row.groups[1]) end
    if re_find(l, "^[a-z]+: [0-9]+ terms, ") ~= nil then push(said, l) end
  end
  local want = {}
  for l in lines(read(COMPOSITION_GOLDEN)) do
    if re_find(l, "^[0-9]+  ") ~= nil or re_find(l, "^[a-z]+: [0-9]+ terms, ") ~= nil then push(want, l) end
  end
  if join(said, "\n") ~= join(want, "\n") or #want ~= 10 then
    print(r.out)
    fail("book: compose_main's counts differ from " .. COMPOSITION_GOLDEN .. ", so /" .. DEST_NAME .. "/ is left as it was")
  end
  print("book: compose_main wrote the four final polynomials in " .. r.ms .. " ms, its 10 counts as " .. COMPOSITION_GOLDEN .. " has them")
  return nil
end

-- A program of src/ that prints the book's tables, `count` of them, each
-- a block apart: the book's source must hold each byte for byte. The
-- tableaux in "The tableau, filled in" are src/tableau_main.c's, and the
-- 16 formal languages as Boolean expressions in "The formal languages, seen
-- from outside",
-- and the step's expressions, the counts and two sums of products in "Six
-- expressions, composed", are src/boolean_main.c's. The census tables and
-- witnesses in "Nibble++" and "Two theorems about Nibble++" are
-- src/plus_book_main.c's, and the members and non-members of ACCEPTS,
-- DECIDES and SOLVABLE in "Nibble, sized" are src/sized_main.c's. The
-- "1689, here" boxes, program 1689 in each form the book gives the machine,
-- are src/guide_main.c's, and the "is_not_14, here" boxes of the Nibble++
-- chapters src/guide_plus_main.c's.
function check_tables(name, count)
  must(run({"gcc", "-O2", "-std=c11", "-Wall", "-Wextra", "-Werror", "-o", real(COMPOSED) .. "/" .. name, "src/" .. name .. ".c"}, {timeout_ms = 120000, tail = 20}))
  local r = must(run({real(COMPOSED .. "/" .. name)}, {timeout_ms = 60000, whole = 40000, want = "book: " .. name .. ", just built from src/ for the book"}))
  local tables = split(trim(r.out), "\n\n")
  if #tables ~= count then fail("book: " .. name .. " printed " .. #tables .. " tables, not " .. count) end
  local source = read("book/book.md")
  for t in tables do
    if find(source, t) == nil then
      print(t)
      fail("book: book/book.md lacks " .. name .. "'s table above, so /" .. DEST_NAME .. "/ is left as it was")
    end
  end
  print("book: the " .. count .. " tables of " .. name .. " are in book/book.md as it prints them")
  return nil
end

-- The blocks of "The Boolean view" and "The program left unknown" that
-- python/steps.py prints with `book`: a run at AX = 2 bit by bit, the
-- formula's sizes, and its formula at AX = 0. The book's source must hold
-- each byte for byte.
function check_steps()
  local r = must(run({"python3", "python/steps.py", "book"}, {timeout_ms = 60000, whole = 40000, want = "book: python/steps.py, the book's Python, prints its blocks"}))
  local blocks = split(trim(r.out), "\n\n")
  if #blocks ~= 3 then fail("book: python/steps.py printed " .. #blocks .. " blocks, not 3") end
  local source = read(SOURCE)
  for b in blocks do
    if find(source, b) == nil then
      print(b)
      fail("book: book/book.md lacks python/steps.py's block above, so /" .. DEST_NAME .. "/ is left as it was")
    end
  end
  print("book: the 3 blocks of python/steps.py are in book/book.md as it prints them")
  return nil
end

-- The blocks of "The SAT solver": sat/intro.shale's example CNF, and
-- rocsat's answers on the happy path and the unhappy paths, as it wrote them
-- to sat/intro/. The book's source must hold each byte for byte.
function check_intro()
  local blocks = {"```text\n" .. trim(read("sat/intro/example.cnf")) .. "\n```"}
  for b in split(trim(read("sat/intro/verdicts.txt")), "\n\n") do push(blocks, "```text\n" .. b .. "\n```") end
  if #blocks ~= 3 then fail("book: sat/intro/verdicts.txt holds " .. (#blocks - 1) .. " blocks, not 2") end
  local source = read(SOURCE)
  for b in blocks do
    if find(source, b) == nil then
      print(b)
      fail("book: book/book.md lacks the SAT solver block above, so /" .. DEST_NAME .. "/ is left as it was")
    end
  end
  print("book: sat/intro.shale's CNF and rocsat's 5 answers on it are in book/book.md")
  return nil
end

-- The blocks of "One formula for the whole machine" and "Checking a claim":
-- python/fourteen_cnf.py's six with `book`, and rocsat's verdicts as
-- sat/fourteen.shale wrote them to sat/fourteen/verdicts.txt, in a "1689,
-- here" box. The book's
-- source must hold each byte for byte.
function check_fourteen()
  local r = must(run({"python3", "python/fourteen_cnf.py", "book"}, {timeout_ms = 60000, whole = 40000, want = "book: python/fourteen_cnf.py, the book's Python, prints its blocks"}))
  local blocks = split(trim(r.out), "\n\n")
  if #blocks ~= 6 then fail("book: python/fourteen_cnf.py printed " .. #blocks .. " blocks, not 6") end
  push(blocks, "```text 1689, here: rocsat checks the claim on each input\n" .. trim(read("sat/fourteen/verdicts.txt")) .. "\n```")
  local source = read(SOURCE)
  for b in blocks do
    if find(source, b) == nil then
      print(b)
      fail("book: book/book.md lacks the Fourteen block above, so /" .. DEST_NAME .. "/ is left as it was")
    end
  end
  print("book: the 6 blocks of python/fourteen_cnf.py and rocsat's 4 verdicts are in book/book.md")
  return nil
end

-- The circuit chapters' drawings and tables, src/circuit_main.c's: each
-- block it prints, a blank line apart, is in the book's source byte for byte
-- ("Parts for a small computer", "The machine as a circuit" and "The
-- circuit, in full"). It also draws the parts' schematics into
-- book/build/schematics/, one SVG each, which the app's `schematic` fences
-- embed (book/app/Schematics.roc), so each is the netlist's as built, and
-- writes the decider's equations to book/build/equations.txt, which the
-- app's `equations` fence shows whole (book/app/Equations.roc).
function check_circuit()
  must(run({"gcc", "-O2", "-std=c11", "-Wall", "-Wextra", "-Werror", "-o", real(COMPOSED) .. "/circuit_main", "src/circuit_main.c"}, {timeout_ms = 120000, tail = 20}))
  local exe = real(COMPOSED .. "/circuit_main")
  local want = "book: circuit_main, just built from src/ for the book"
  local blocks = split(trim(must(run({exe}, {timeout_ms = 60000, whole = 100000, want = want})).out), "\n\n")
  if #blocks ~= CIRCUIT_BLOCKS then fail("book: circuit_main printed " .. #blocks .. " blocks, not " .. CIRCUIT_BLOCKS) end
  local source = read(SOURCE)
  for b in blocks do
    if find(source, b) == nil then
      print(b)
      fail("book: book/book.md lacks circuit_main's block above, so /" .. DEST_NAME .. "/ is left as it was")
    end
  end
  if exists(SCHEMATICS) then remove_tree(SCHEMATICS) end
  mkdir(SCHEMATICS)
  must(run({exe, "svg", real(SCHEMATICS)}, {timeout_ms = 60000, whole = 2000, want = want}))
  replace(EQUATIONS, must(run({exe, "equations"}, {timeout_ms = 60000, whole = 400000, want = want})).out)
  local drawn = #glob(SCHEMATICS .. "/*.svg")
  if drawn ~= CIRCUIT_SCHEMATICS then fail("book: circuit_main drew " .. drawn .. " schematics, not " .. CIRCUIT_SCHEMATICS) end
  print("book: the " .. #blocks .. " drawings and tables of circuit_main are in book/book.md as it prints them, and its " .. drawn .. " schematics are drawn")
  return nil
end

-- A program's number, as "Program numbers" in "The machine" defines it: its
-- lines as base-4 digits, line 1 first, nada 0, zero 1, decr 2 and mod2 3,
-- a program of fewer than six lines padded with nada.
function program_number(names)
  local digit = {nada = 0, zero = 1, decr = 2, mod2 = 3, ["00"] = 0, ["01"] = 1, ["10"] = 2, ["11"] = 3}
  -- A program in bits, `01 10 10 01 10 01`, is one item of six pairs.
  if #names == 1 and find(names[1], " ") ~= nil then names = split(trim(names[1]), " ") end
  if #names > 6 then return nil end
  local n = 0
  for k = 1, 6 do
    local name = "nada"
    if k <= #names then name = trim(names[k]) end
    if not has_key(digit, name) then return nil end
    n = n * 4 + digit[name]
  end
  return n
end

-- Every "program N" in the book's source names its program: either it is
-- followed by the program in backticks, "program 2916 (`decr, mod2, ...`)",
-- or by a colon and the program as a text block, one line an opcode; or it is
-- a number some such mention has already shown. The build holds each number
-- to its program.
function check_program_numbers()
  local text = read(SOURCE)
  local shown = {}
  local wrong = {}
  local named = 0
  for m in re_find_all(text, "[Pp]rogram ([0-9]+) \\(`([a-z0-9, ]+)`\\)") do
    local n = program_number(split(m.groups[2], ","))
    if n ~= tonumber(m.groups[1]) then push(wrong, "program " .. m.groups[1] .. " is shown as `" .. m.groups[2] .. "`, which is program " .. tostring(n)) end
    shown[m.groups[1]] = true
    named = named + 1
  end
  for m in re_find_all(text, "[Pp]rogram ([0-9]+):\n\n```text\n([a-z0-9\n]+)```") do
    local n = program_number(split(trim(m.groups[2]), "\n"))
    if n ~= tonumber(m.groups[1]) then push(wrong, "program " .. m.groups[1] .. "'s block is program " .. tostring(n)) end
    shown[m.groups[1]] = true
    named = named + 1
  end
  for m in re_find_all(text, "[Pp]rogram ([0-9]+)") do
    if not has_key(shown, m.group) then push(wrong, "program " .. m.group .. " is named with no program beside it anywhere") end
  end
  if #wrong > 0 then
    for w in wrong do print("  " .. w) end
    fail("book: the book's program numbers differ from their programs, so /" .. DEST_NAME .. "/ is left as it was")
  end
  print("book: " .. named .. " programs named by number, each its number")
  return nil
end

-- The worked examples in "Cook-Levin as SAT" and "Solved by hand" are
-- src/sat_hand_main.c's output, which the book's source must hold byte for
-- byte: each of its blocks, a blank line between them.
function check_hand()
  mkdir(SAT_DIR)
  must(run({"gcc", "-O2", "-std=c11", "-Wall", "-Wextra", "-Werror", "-o", real(SAT_DIR) .. "/sat_hand", "src/sat_hand_main.c"}, {timeout_ms = 120000, tail = 20}))
  local r = must(run({real(SAT_DIR .. "/sat_hand"), real(PROOFS .. "/13-len5.drat")}, {timeout_ms = 60000, whole = 40000, want = "book: sat_hand, just built from src/ for the book"}))
  local blocks = split(trim(r.out), "\n\n")
  if #blocks ~= 8 then fail("book: sat_hand printed " .. #blocks .. " blocks, not 8") end
  local source = read(SOURCE)
  for b in blocks do
    if find(source, b) == nil then
      print(b)
      fail("book: book/book.md lacks sat_hand's block above, so /" .. DEST_NAME .. "/ is left as it was")
    end
  end
  print("book: the " .. #blocks .. " worked SAT examples in book/book.md are sat_hand's output")
  return nil
end

-- The blocks of "From equations to CNF": python/distribute.py's sizes for
-- the decider's equations (EQUATIONS, which check_circuit writes), and
-- rocsat's verdicts on the three claims and two gates' lines of the first
-- claim's CNF, as sat/claims.shale wrote them to sat/claims/verdicts.txt and
-- sat/claims/gates.txt. The book's source must hold each byte for byte.
function check_cnf()
  local r = must(run({"python3", "python/distribute.py", real(EQUATIONS), "book"}, {timeout_ms = 120000, whole = 4000, want = "book: python/distribute.py, the book's Python, prints its block", nice = 10}))
  local blocks = {trim(r.out), "```text\n" .. trim(read("sat/claims/verdicts.txt")) .. "\n```"}
  for g in split(trim(read("sat/claims/gates.txt")), "\n\n") do push(blocks, "```text\n" .. g .. "\n```") end
  if #blocks ~= 4 then fail("book: sat/claims/gates.txt holds " .. (#blocks - 2) .. " gates, not 2") end
  local source = read(SOURCE)
  for b in blocks do
    if find(source, b) == nil then
      print(b)
      fail("book: book/book.md lacks the CNF block above, so /" .. DEST_NAME .. "/ is left as it was")
    end
  end
  print("book: python/distribute.py's sizes, rocsat's 3 claim verdicts and the 2 gates' clauses are in book/book.md")
  return nil
end

-- A count with a comma before each group of three digits.
function commas(n)
  local s = "" .. n
  local out = ""
  for i = 1, #s do
    if i > 1 and (#s - i + 1) % 3 == 0 then out = out .. "," end
    out = out .. sub(s, i, i)
  end
  return out
end

-- A set of inputs as sat/plus/search.txt writes it, `{0, 1, 2, 4}`, with
-- each run of three or more as its ends, `{0, ..., 2, 4}`.
function members_named(set_text)
  local ns = {}
  for w in split(sub(set_text, 2, #set_text - 1), ", ") do push(ns, tonumber(w)) end
  local parts = {}
  local i = 1
  while i <= #ns do
    local j = i
    while j < #ns and ns[j + 1] == ns[j] + 1 do j = j + 1 end
    if j - i >= 2 then
      push(parts, "" .. ns[i] .. ", ..., " .. ns[j])
    else
      for k = i, j do push(parts, "" .. ns[k]) end
    end
    i = j + 1
  end
  return "{" .. join(parts, ", ") .. "}"
end

-- The blocks of "Nibble++ meets rocsat". The CNF sizes at the longest search
-- case's length, from src/plus_sat_main.c: one run's circuit, and the search
-- CNF of that case. rocsat's answers on the evaluation claims, as
-- sat/plus.shale wrote them to sat/plus/verdicts.txt, with each answer's
-- solver statistics left out. The search cases of sat/plus/search.txt as a
-- table, its times left out, since they vary from run to run. And the cases
-- where rocsat's program differs from the census witness
-- (`plus_sat census`): each of eight lines or fewer shown, and the count of
-- them all held in the prose, "in N of the M cases". The guided search of
-- sat/plus/guided.txt as a table, its times left out. The book's source must
-- hold each block byte for byte.
function check_plus_sat()
  mkdir(SAT_DIR)
  must(run({"gcc", "-O2", "-o", real(SAT_DIR) .. "/plus_sat", "src/plus_sat_main.c"}, {timeout_ms = 120000, tail = 20}))
  local exe = real(SAT_DIR .. "/plus_sat")
  local want = "book: plus_sat, just built from src/ for the book"
  local cases = {}
  for l in lines(read(PLUS_SEARCH)) do
    local f = split(re_replace(trim(l), "  +", "\t"), "\t")
    if #f == 8 and re_find(f[1], "^[0-9]+$") ~= nil then
      push(cases, {w = f[1], set = members_named(f[2]), L = tonumber(f[3]), sat = split(f[4], ",")[1], unsat = split(f[5], ",")[1], proof = f[6], checked = f[7], program = f[8]})
    end
  end
  if #cases == 0 then fail("book: " .. PLUS_SEARCH .. " holds no search cases") end
  local blocks = {}

  local last = cases[#cases]
  local k = "" .. last.L
  local one = split(trim(must(run({exe, "size", k}, {timeout_ms = 20000, whole = 2000, want = want})).out), " ")
  local search = must(run({exe, "search", last.w, k}, {timeout_ms = 20000, head = 3, want = want})).out
  local gates = re_find(search, "16 runs, ([0-9]+) gates")
  local header = re_find(search, "\np cnf ([0-9]+) ([0-9]+)\n")
  if gates == nil or header == nil then fail("book: plus_sat search " .. last.w .. " " .. k .. " printed no gate count or header") end
  push(blocks, "| CNF at " .. k .. " lines | Gates | Variables | Clauses |\n|---|---:|---:|---:|\n| one run, its input free | " .. one[2] .. " | " .. one[3] .. " | " .. one[4] .. " |\n| the search for " .. last.set .. " | " .. gates.group .. " | " .. header.groups[1] .. " | " .. header.groups[2] .. " |")

  local claims = {}
  for l in lines(read(PLUS_VERDICTS)) do
    if starts_with(l, "program ") then push(claims, re_replace(l, ", conflicts=[^;]*;", ";")) end
  end
  if #claims ~= 5 then fail("book: " .. PLUS_VERDICTS .. " holds " .. #claims .. " claims, not 5") end
  push(blocks, "```text\n" .. join(slice(claims, 1, 2), "\n") .. "\n```")
  push(blocks, "```text\n" .. join(slice(claims, 3, 5), "\n") .. "\n```")

  local rows = {"| Formal language | Census length L | L lines | L − 1 lines | The proof at L − 1 | Model and proof checked |", "|---|---:|---|---|---:|---|"}
  for c in cases do
    local bytes = re_find(c.proof, "^([0-9]+) bytes")
    local size = bytes == nil and c.proof or commas(tonumber(bytes.group)) .. " bytes"
    local checked = c.checked == "model yes, proof yes" and "yes" or c.checked
    push(rows, "| " .. c.set .. " | " .. c.L .. " | " .. c.sat .. " | " .. c.unsat .. " | " .. size .. " | " .. checked .. " |")
  end
  push(blocks, join(rows, "\n"))

  local argv = {exe, "census"}
  for c in cases do push(argv, c.w) end
  local witness = {}
  for l in lines(must(run(argv, {timeout_ms = 60000, whole = 20000, want = want})).out) do
    local f = split(l, " ")
    if #f == 3 then witness[f[1]] = f[3] end
  end
  local differ = 0
  local shown = {}
  for c in cases do
    if witness[c.w] ~= c.program then
      differ = differ + 1
      if c.L <= 8 then
        push(shown, c.set .. ", the census: " .. join(split(witness[c.w], ","), ", "))
        push(shown, c.set .. ", rocsat:     " .. join(split(c.program, ","), ", "))
      end
    end
  end
  push(blocks, "```text\n" .. join(shown, "\n") .. "\n```")

  local source = read(SOURCE)
  for b in blocks do
    if find(source, b) == nil then
      print(b)
      fail("book: book/book.md lacks the Nibble++ SAT block above, so /" .. DEST_NAME .. "/ is left as it was")
    end
  end
  -- The guided search of sat/plus_guided.shale: each case's inputs at L
  -- and at L - 1, and the two proofs' sizes, its times left out.
  local guided = {"| Formal language | L | Inputs asked at L | Inputs asked at L − 1 | Its proof | The full proof | Checked |", "|---|---:|---:|---:|---:|---:|---|"}
  local guided_cases = 0
  for l in lines(read(PLUS_GUIDED)) do
    local f = split(re_replace(trim(l), "  +", "\t"), "\t")
    if #f == 12 and re_find(f[1], "^[0-9]+$") ~= nil then
      local at = re_find(f[4], "^SAT on ([0-9]+): ")
      local below = re_find(f[7], "^UNSAT on ([0-9]+): ")
      local proof = re_find(f[10], "^([0-9]+) B, ")
      local full_proof = re_find(f[11], "^([0-9]+) B, ")
      if at == nil or below == nil or proof == nil or full_proof == nil or f[12] ~= "model yes, proof yes" then fail("book: " .. PLUS_GUIDED .. "'s case " .. f[1] .. " is no SAT and checked UNSAT: " .. trim(l)) end
      push(guided, "| " .. members_named(f[2]) .. " | " .. f[3] .. " | " .. at.group .. " | " .. below.group .. " | " .. commas(tonumber(proof.group)) .. " bytes | " .. commas(tonumber(full_proof.group)) .. " bytes | yes |")
      guided_cases = guided_cases + 1
    end
  end
  if guided_cases ~= #cases then fail("book: " .. PLUS_GUIDED .. " holds " .. guided_cases .. " cases, not " .. #cases) end
  if find(source, join(guided, "\n")) == nil then
    print(join(guided, "\n"))
    fail("book: book/book.md lacks the guided search's table above, so /" .. DEST_NAME .. "/ is left as it was")
  end

  local count = "in " .. differ .. " of the " .. #cases .. " cases"
  if find(source, count) == nil then fail("book: book/book.md lacks \"" .. count .. "\", rocsat's programs against the census witnesses, so /" .. DEST_NAME .. "/ is left as it was") end
  print("book: the " .. #blocks .. " Nibble++ SAT blocks are in book/book.md, " .. #cases .. " search cases, rocsat's program the census's " .. (#cases - differ) .. " times")
  return nil
end

-- A language's set of inputs, `{0, 2, 3}`, from its code.
function language_set(lang)
  local items = {}
  local left = lang
  local powers = {8, 4, 2, 1}
  local found = {}
  for k = 1, 4 do
    if left >= powers[k] then
      left = left - powers[k]
      push(found, 4 - k)
    end
  end
  for k = #found, 1, -1 do push(items, "" .. found[k]) end
  return "{" .. join(items, ", ") .. "}"
end

-- The puzzles' names, by language code from 0, as web/puzzles.c lists them.
function puzzle_names()
  local text = read("web/puzzles.c")
  local list = between(text, "\"grumpy\"", "\"always_true\"")
  local names = {"grumpy"}
  for m in re_find_all(list, "\"([a-z_]+)\"") do push(names, m.group) end
  push(names, "always_true")
  if #names ~= 16 then fail("book: web/puzzles.c names " .. #names .. " puzzles, not 16") end
  return names
end

-- Puzzle `lang`'s CNF with lines past `len` forced to nada, written to
-- SAT_DIR; gives its path.
function write_cnf(lang, len)
  local path = SAT_DIR .. "/" .. lang .. "-len" .. len .. ".cnf"
  local r = must(run({real(SAT_DIR .. "/sat"), "" .. lang, "len=" .. len}, {timeout_ms = 20000, whole = 4000000, want = SAT_WANT}))
  replace(path, r.out)
  return path
end

-- The program code an answer's first 12 variables name, and its ops.
function program_of(answer)
  local bits = {}
  for v = 1, 12 do push(bits, -1) end
  for l in re_lines(answer, "^v ") do
    for w in words(l.text) do
      local x = parse_int(w)
      if x ~= nil and x ~= 0 and abs(x) <= 12 then
        if x > 0 then bits[x] = 1 else bits[-x] = 0 end
      end
    end
  end
  local code = 0
  local place = 1
  local ops = {}
  for i = 1, 6 do
    local op = 2 * bits[2 * i - 1] + bits[2 * i]
    if op < 0 then fail("book: an answer leaves instruction " .. i .. "'s bits unnamed") end
    code = code + op * place
    place = place * 4
    push(ops, OPS[op + 1])
  end
  return {code = code, ops = join(ops, ", ")}
end

-- rocsat's committed proofs and answers, checked by the repository's C
-- before the chapter shows them, and the chapter held to what is found.
function check_solver_files()
  mkdir(SAT_DIR)
  must(run({"gcc", "-O2", "-o", real(SAT_DIR) .. "/sat", "src/sat_main.c"}, {timeout_ms = 120000, tail = 20}))
  must(run({"gcc", "-O2", "-o", real(SAT_DIR) .. "/drat", "src/drat_main.c"}, {timeout_ms = 120000, tail = 20}))
  local text = read(SOURCE)
  local names = puzzle_names()
  local wrong = {}
  local proofs = 0
  local answers = 0
  for p in glob(PROOFS .. "/*.drat") do
    local m = re_find(basename(p), "^([0-9]+)-len([0-5])\\.drat$")
    if m == nil then fail("book: " .. p .. " is named as no proof of the oracle's") end
    local lang = tonumber(m.groups[1])
    local len = tonumber(m.groups[2])
    local said = run({real(SAT_DIR .. "/drat"), "check", real(write_cnf(lang, len)), real(p)}, {timeout_ms = 60000, tail = 3, want = SAT_WANT})
    if get(said, "code", -1) ~= 0 then fail("book: " .. p .. " fails the checker: " .. trim(said.out) .. ", so /" .. DEST_NAME .. "/ is left as it was") end
    local proof = read(p)
    local lemmas = 0
    for l in lines(proof) do
      if l ~= "" and not starts_with(l, "d ") then lemmas = lemmas + 1 end
    end
    local row = "| " .. lang .. " | `" .. names[lang + 1] .. "` | " .. language_set(lang) .. " | " .. (len + 1) .. " | " .. commas(#proof) .. " | " .. commas(lemmas) .. " | yes |"
    if find(text, row) == nil then push(wrong, "the table has no row " .. row) end
    if find(text, "```dimacs " .. p) ~= nil and find(text, "`" .. trim(said.out) .. "`") == nil then push(wrong, "the chapter shows " .. p .. " and quotes no `" .. trim(said.out) .. "`") end
    proofs = proofs + 1
  end
  for p in glob(PROOFS .. "/*.model") do
    local m = re_find(basename(p), "^([0-9]+)-len([0-6])\\.model$")
    if m == nil then fail("book: " .. p .. " is named as no answer of the oracle's") end
    local lang = tonumber(m.groups[1])
    local cnf = write_cnf(lang, tonumber(m.groups[2]))
    local said = run({real(SAT_DIR .. "/drat"), "model", real(cnf), real(p)}, {timeout_ms = 60000, tail = 3, want = SAT_WANT})
    if get(said, "code", -1) ~= 0 then fail("book: " .. p .. " is no model of " .. cnf .. ": " .. trim(said.out)) end
    local program = program_of(read(p))
    local solves = run({real(SAT_DIR .. "/sat"), "solves", "" .. lang, "" .. program.code}, {timeout_ms = 20000, tail = 1, want = SAT_WANT})
    if get(solves, "code", -1) ~= 0 then fail("book: " .. p .. "'s program " .. program.code .. " fails puzzle " .. lang .. " on the machine") end
    if find(text, "```dimacs " .. p) ~= nil and find(text, "`" .. program.ops .. "`") == nil then push(wrong, "the chapter shows " .. p .. " and quotes no `" .. program.ops .. "`") end
    answers = answers + 1
  end
  -- The unhappy path: the proof for {0, 2, 3} at five lines, handed the
  -- formula at six, which is satisfiable, is refused, and the chapter quotes
  -- the refusal.
  local refused = run({real(SAT_DIR .. "/drat"), "check", real(write_cnf(13, 6)), real(PROOFS .. "/13-len5.drat")}, {timeout_ms = 60000, tail = 3, want = SAT_WANT})
  if get(refused, "code", -1) == 0 then fail("book: the checker accepts the five-line proof against the six-line formula") end
  if find(text, "`" .. trim(refused.out) .. "`") == nil then push(wrong, "the chapter quotes no `" .. trim(refused.out) .. "`, the checker's refusal") end
  if proofs ~= 15 or answers ~= 16 then fail("book: " .. PROOFS .. " holds " .. proofs .. " proofs and " .. answers .. " answers, not 15 and 16") end
  if #wrong > 0 then
    for w in wrong do print("  " .. w) end
    fail("book: the SAT chapter differs from what the checks found, so /" .. DEST_NAME .. "/ is left as it was")
  end
  print("book: " .. proofs .. " DRAT proofs verified by src/drat.c and " .. answers .. " answers held to their CNFs and the machine, all from " .. PROOFS .. "/")
  return nil
end

-- The small worked examples of "The SAT solver", "Naming the gates", "Proofs
-- of unsatisfiability" and "What comes next": each block sat/walkthrough.shale
-- prints, in the book's source byte for byte. The two DRAT proofs it writes
-- are checked by src/drat.c (built by check_solver_files), and the chapter
-- quotes the checker's line for the small proof.
function check_walkthrough()
  local r = must(run({"shale", "sat/walkthrough.shale"}, {timeout_ms = 60000, whole = 20000}))
  local kept = {}
  for l in lines(r.out) do
    if not starts_with(l, "── ") then push(kept, l) end
  end
  local blocks = {}
  for b in split(trim(join(kept, "\n")), "\n\n") do
    if starts_with(b, "```") then push(blocks, b) end
  end
  if #blocks ~= WALKTHROUGH_BLOCKS then fail("book: sat/walkthrough.shale printed " .. #blocks .. " blocks, not " .. WALKTHROUGH_BLOCKS) end
  local source = read(SOURCE)
  for b in blocks do
    if find(source, b) == nil then
      print(b)
      fail("book: book/book.md lacks sat/walkthrough.shale's block above, so /" .. DEST_NAME .. "/ is left as it was")
    end
  end
  for name in {"no_opcode", "circuit_false"} do
    local said = run({real(SAT_DIR .. "/drat"), "check", real("sat/walkthrough/" .. name .. ".cnf"), real("sat/walkthrough/" .. name .. ".drat")}, {timeout_ms = 10000, tail = 3, want = SAT_WANT})
    if get(said, "code", -1) ~= 0 then fail("book: sat/walkthrough/" .. name .. ".drat fails the checker: " .. trim(said.out)) end
    if name == "no_opcode" and find(source, "`" .. trim(said.out) .. "`") == nil then fail("book: book/book.md quotes no `" .. trim(said.out) .. "`, the checker's line for the small proof") end
  end
  print("book: the " .. #blocks .. " blocks of sat/walkthrough.shale are in book/book.md, and its 2 proofs pass src/drat.c")
  return nil
end

-- Every commit the manuscript cites resolves: a short hash in backticks is a
-- commit of this repository. The Python repository's commits are cited as
-- links to GitHub, outside the backticks, and this check leaves them alone.
function check_citations()
  local text = read(SOURCE)
  local cited = 0
  local hashes = {}
  for m in re_find_all(text, "`([0-9a-f]{7,12})`") do
    cited = cited + 1
    hashes[m.group] = true
  end
  local wrong = {}
  for h in sort(keys(hashes)) do
    local r = run({"git", "-C", real("."), "cat-file", "-e", h .. "^{commit}"}, {timeout_ms = 10000, whole = 2000})
    if r.code ~= 0 then push(wrong, h .. " is no commit of this repository") end
  end
  if #wrong > 0 then
    for w in wrong do print("  " .. w) end
    fail("book: " .. #wrong .. " of the manuscript's cited commits don't resolve, so /" .. DEST_NAME .. "/ is left as it was")
  end
  print("book: " .. cited .. " citations of " .. #keys(hashes) .. " commits resolve")
  return nil
end

-- The book's numbered things hold together: its theorems, each stated as
-- `**Theorem N.**`, and its monstrosities, the big outputs, each labelled
-- `**Monstrosity N:`. Each number is given once, and they run 1, 2, 3 and
-- on through the book in order; every other "Theorem N" or "Monstrosity N",
-- and each number of "Theorems N and M" or "N to M", names one of them. A
-- number given twice, out of order, or named and never given stops the
-- build.
function check_numbered(word, plural)
  local text = read(SOURCE)
  local stated = {}
  local wrong = {}
  local count = 0
  local mark = word == "Theorem" and "\\." or ":"
  for m in re_find_all(text, "\\*\\*" .. word .. " ([0-9]+)" .. mark) do
    count = count + 1
    local n = m.group
    if has_key(stated, n) then push(wrong, word .. " " .. n .. " is given twice") end
    if tonumber(n) ~= count then push(wrong, "the " .. word .. " given " .. count .. " in order is numbered " .. n) end
    stated[n] = true
  end
  local named = 0
  for m in re_find_all(text, "(?:" .. word .. "|" .. plural .. ") ([0-9]+)((?:(?:, | and | to )[0-9]+)*)") do
    local numbers = {m.groups[1]}
    for k in re_find_all(m.groups[2], "([0-9]+)") do push(numbers, k.group) end
    for n in numbers do
      named = named + 1
      if not has_key(stated, n) then push(wrong, word .. " " .. n .. " is named and never given") end
    end
  end
  if count == 0 then fail("book: book/book.md gives no " .. word) end
  if #wrong > 0 then
    for w in wrong do print("  " .. w) end
    fail("book: the book's " .. plural .. "' numbers don't hold together, so /" .. DEST_NAME .. "/ is left as it was")
  end
  print("book: " .. count .. " " .. plural .. " given once each, numbered 1 to " .. count .. " in order, and " .. (named - count) .. " references to them, each to one")
  return nil
end

-- The "Run it" boxes, one under each theorem: a ```text fence titled "Run it"
-- whose first line is `$ out/tcc/test_NAME`, the test binary `shale
-- build.shale` builds, whose second is the line it prints, `tests/test_NAME.c:
-- N tests passed`, and whose others name the tests that prove the theorem,
-- `the test: NAME`. Each line is held to the test file: N to its `TEST(`
-- count, as build.shale holds the binary's own line, and each test named to
-- one of its `TEST(NAME)`s. A box of another shape, or a count of boxes other
-- than the theorems', stops the build.
function check_run_it()
  local text = read(SOURCE)
  local wrong = {}
  local boxes = 0
  for m in re_find_all(text, "```text Run it\n\\$ out/tcc/(test_[a-z0-9_]+)\n([^\n]*)\n((?:the test: [a-z0-9_]+\n)*)```") do
    boxes = boxes + 1
    local file = "tests/" .. m.groups[1] .. ".c"
    if not exists(file) then
      push(wrong, "a Run it box runs " .. m.groups[1] .. ", and there is no " .. file)
    else
      local n = 0
      for g in grep(file, "TEST(") do
        if starts_with(g.text, "TEST(") then n = n + 1 end
      end
      local said = file .. ": " .. n .. " tests passed"
      if m.groups[2] ~= said then push(wrong, "a Run it box says `" .. m.groups[2] .. "`, where " .. m.groups[1] .. " says `" .. said .. "`") end
      for t in re_find_all(m.groups[3], "the test: ([a-z0-9_]+)\n") do
        if #grep(file, "TEST(" .. t.group .. ")") == 0 then push(wrong, "a Run it box names the test " .. t.group .. ", which " .. file .. " lacks") end
      end
    end
  end
  local opened = #find_all(text, "```text Run it\n")
  if opened ~= boxes then push(wrong, opened .. " Run it boxes open, and " .. boxes .. " have the box's shape") end
  local theorems = #re_find_all(text, "\\*\\*Theorem [0-9]+\\.\\*\\*")
  if boxes ~= theorems then push(wrong, boxes .. " Run it boxes for " .. theorems .. " theorems") end
  if #wrong > 0 then
    for w in wrong do print("  " .. w) end
    fail("book: the Run it boxes differ from the tests, so /" .. DEST_NAME .. "/ is left as it was")
  end
  print("book: " .. boxes .. " Run it boxes, one a theorem, each line its test file's")
  return nil
end

-- `to`, a real path, as a path relative to the real folder `from`.
function relative_path(from, to)
  local a = split(from, "/")
  local b = split(to, "/")
  local i = 1
  while i <= #a and i <= #b and a[i] == b[i] do i = i + 1 end
  local parts = {}
  for j = i, #a do push(parts, "..") end
  for j = i, #b do push(parts, b[j]) end
  return join(parts, "/")
end

function main()
  if not exists(HERE) or real(HERE) ~= real(".") then fail("book: run from the checkout at " .. HERE .. " (" .. (exists(HERE) and real(HERE) or "not there") .. "), which roc-apps' tools reach by that mount") end
  if not exists(ROC_APPS .. "/" .. BUILD) then fail("book: no " .. ROC_APPS .. "/" .. BUILD .. ": clone roc-apps beside this checkout") end
  check_citations()
  check_numbered("Theorem", "Theorems")
  check_numbered("Monstrosity", "Monstrosities")
  check_run_it()
  if exists(PREPARED) then remove_tree(PREPARED) end
  mkdir(PREPARED)
  local drawn = must(run({"shale", "--root", ".", DRAW, "source=" .. HERE .. "/" .. SOURCE, "prepared=" .. HERE .. "/" .. PREPARED}, {cwd = ROC_APPS, timeout_ms = 120000, tail = 20, want = DOT_WANT}))
  for l in lines(drawn.out) do
    if starts_with(l, "draw_diagrams: ") then print("book: " .. sub(l, 16) .. " in " .. drawn.ms .. " ms") end
  end
  compose_polynomials()
  check_tables("tableau_main", 2)
  check_tables("boolean_main", 4)
  check_tables("plus_book_main", 7)
  check_tables("sized_main", 3)
  check_tables("guide_main", 13)
  check_tables("guide_plus_main", 5)
  check_circuit()
  check_cnf()
  check_steps()
  check_program_numbers()
  check_intro()
  check_fourteen()
  check_hand()
  check_solver_files()
  check_walkthrough()
  check_plus_sat()

  local app = relative_path(real(ROC_APPS .. "/book_builder"), real(APP_DIR .. "/app/main.roc"))
  local argv = {"shale", "--root", ".", BUILD, "book=" .. HERE .. "/" .. APP_DIR, "tests=" .. APP_TESTS, "name=" .. DEST_NAME, "folder=" .. real("."), "out=" .. HERE .. "/" .. OUT, "report=" .. HERE .. "/" .. REPORT, "app=" .. app}
  local built = run(argv, {cwd = ROC_APPS, timeout_ms = 900000, tail = 60})
  local pages = 0
  for l in lines(built.out) do
    if starts_with(l, "build_book: ") then print("book: " .. sub(l, 13)) end
    local m = re_find(l, "^build_book: ([0-9]+) pages in ")
    if m ~= nil then pages = tonumber(m.groups[1]) end
  end
  if built.code ~= 0 then
    print(trim(built.out))
    fail("book: build_book.shale stopped, so /" .. DEST_NAME .. "/ is left as it was")
  end
  local staging = NEXT .. "/" .. STAGED_NAME
  if exists(staging) then remove_tree(staging) end
  copy(OUT, staging)

  if exists(SHOTS) then remove_tree(SHOTS) end
  mkdir(SHOTS)
  local check_argv = {"nice", "-n", "19", "node", real(ROC_APPS .. "/" .. CHECKER), "http://127.0.0.1:9210/" .. STAGED_NAME .. "/", real(SHOTS)}
  local checked = run(check_argv, {timeout_ms = 600000, tail = 60, want = CHECK_WANT})
  if checked.ended ~= "exit" or checked.code ~= 0 then
    print(trim(checked.out))
    fail("book: book_check failed on " .. staging .. ", so /" .. DEST_NAME .. "/ is left as it was")
  end
  for l in lines(checked.out) do
    if starts_with(l, "book_check: ") then print(l) end
  end
  print("book: book_check, shots in " .. SHOTS .. ", took " .. checked.ms .. " ms")
  local moved = must(run({"shale", "--root", ".", MOVE, "stage=" .. STAGED_NAME, "place=" .. DEST_NAME}, {cwd = ROC_APPS, timeout_ms = 60000, tail = 20}))
  print("book: the move into place took " .. moved.ms .. " ms")

  for l in lines(read(REPORT)) do
    if trim(l) ~= "" then print("book: " .. l) end
  end
  print("book: " .. pages .. " pages at http://localhost:9210/" .. DEST_NAME .. "/")
  return nil
end

main()
