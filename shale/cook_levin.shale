-- budget: steps=1000000000 arena_bytes=400000000
-- shale/cook_levin.shale: Cook-Levin in Shale. The machine, the search over
-- all 4,096 programs, the step polynomials built in the Boolean ring, and
-- all six steps composed, with the proof against the machine at every
-- point. From the repository's root:
--
--   shale shale/cook_levin.shale                    # both reports
--   shale shale/cook_levin.shale part=search        # find_solutions' alone
--   shale shale/cook_levin.shale part=composition   # the composition's alone
--
-- It prints find_solutions' report (tests/golden/find_solutions.txt), then
-- the composition's (roc/golden/composition.txt). `steps=N` composes the
-- first N steps (1 to 6); the proof needs all six, and with fewer the last
-- line says so, as roc/Composition.roc's does.
--
-- Shale's numbers are 64-bit integers, every operation checked, so each
-- coefficient is exact or the run stops. It has no bitwise operators, so a
-- mask's OR and AND are read from tables of two 7-bit halves (14 variables
-- make every mask below 2^14), as js/cook_levin.js reads them, and a bit is
-- a `//` and a `%`. Lists count from 1, so the slot of mask m is m + 1.
--
-- The budgets: the whole run takes about 400 million steps, and a run's
-- values are freed only when it ends, so every polynomial the composition
-- makes on its way is held: it needs between 100 and 300 MB of arena.

local part = arg("part", "all")
local steps = arg("steps", 6)

-- ---------------------------------------------------------------- the machine

const NADA = 0
const ZERO = 1
const DECR = 2
const MOD2 = 3
const OP_NAMES = {"nada", "zero", "decr", "mod2"}
const OP_COMMENTS = {
  "# do nothing",
  "# accept original input if AX = 0",
  "# reject zero or decrement AX",
  "# subtract 2 from AX if AX >= 2",
}
const RUNNING = "running"
const ACCEPTED = "accepted"
const REJECTED = "rejected"
const PROGRAM_LENGTH = 6
const INPUT_COUNT = 4
const PROGRAM_COUNT = 4096
const LANGUAGE_COUNT = 16

-- The machine after one op: `{ax, ending}`, ending RUNNING until it halts.
function machine_step(m, op)
  if m.ending ~= RUNNING then return m end
  if op == ZERO then
    if m.ax == 0 then return {ax = 0, ending = ACCEPTED} end
    return m
  end
  if op == DECR then
    if m.ax == 0 then return {ax = 0, ending = REJECTED} end
    return {ax = m.ax - 1, ending = RUNNING}
  end
  if op == MOD2 then return {ax = m.ax % 2, ending = RUNNING} end
  return m
end

function machine_run(program, input)
  local m = {ax = input, ending = RUNNING}
  for op in program do m = machine_step(m, op) end
  return m
end

-- Program n's six ops: its base-4 digits, the lowest first.
function disassemble(n)
  local program = {}
  local rest = n
  for i = 1, PROGRAM_LENGTH do
    push(program, rest % 4)
    rest = rest // 4
  end
  return program
end

-- The inputs a language's code holds: bit i of the code is input i.
function language_of(code)
  local lang = {}
  local rest = code
  local i = 0
  while rest > 0 do
    if rest % 2 == 1 then push(lang, i) end
    rest = rest // 2
    i = i + 1
  end
  return lang
end

function accepted_code(program)
  local code = 0
  local place = 1
  for input = 0, INPUT_COUNT - 1 do
    if machine_run(program, input).ending == ACCEPTED then code = code + place end
    place = place * 2
  end
  return code
end

function complement_of(lang)
  local out = {}
  for i = 0, INPUT_COUNT - 1 do
    if not has_item(lang, i) then push(out, i) end
  end
  return out
end

function lang_text(lang)
  return "[" .. join(lang, ", ") .. "]"
end

-- ------------------------------------------------------- the Boolean ring
--
-- A polynomial is `{masks, coeffs}`: its terms ascend by mask, each mask
-- once, no coefficient 0. A monomial is a set of variables, bit i of its
-- mask for variable i, and the product of two is their union.

const VARIABLE_LIMIT = 14
const SIZE = 16384
const HALF = 128

-- POW2[i + 1] is 2^i.
function powers()
  local out = {1}
  for i = 1, VARIABLE_LIMIT do push(out, 2 * out[i]) end
  return out
end

const POW2 = powers()

-- The OR (or, with `both`, the AND) of every two 7-bit numbers a and b, at
-- slot a * 128 + b + 1.
function half_table(both)
  local out = {}
  for a = 0, HALF - 1 do
    for b = 0, HALF - 1 do
      local bits = 0
      local x = a
      local y = b
      for i = 1, 7 do
        local on = x % 2 == 1 or y % 2 == 1
        if both then on = x % 2 == 1 and y % 2 == 1 end
        if on then bits = bits + POW2[i] end
        x = x // 2
        y = y // 2
      end
      push(out, bits)
    end
  end
  return out
end

const OR7 = half_table(false)
const AND7 = half_table(true)

-- POP[m + 1] is how many bits m has.
function pop_table()
  local out = {0}
  for m = 1, SIZE - 1 do push(out, out[m // 2 + 1] + m % 2) end
  return out
end

const POP = pop_table()

function or14(a, b)
  return OR7[(a // HALF) * HALF + b // HALF + 1] * HALF + OR7[(a % HALF) * HALF + b % HALF + 1]
end

function and14(a, b)
  return AND7[(a // HALF) * HALF + b // HALF + 1] * HALF + AND7[(a % HALF) * HALF + b % HALF + 1]
end

-- The dense table like terms are summed in, by mask: made once, every slot
-- 0 between uses.
function zeros(n)
  local out = {}
  for i = 1, n do push(out, 0) end
  return out
end

const SUMS = zeros(SIZE)

-- The table's slots for masks 0 to `width` as a canonical polynomial, each
-- slot put back to 0.
function from_sums(width)
  local masks = {}
  local coeffs = {}
  for m = 0, width do
    local c = SUMS[m + 1]
    if c ~= 0 then
      push(masks, m)
      push(coeffs, c)
      SUMS[m + 1] = 0
    end
  end
  return {masks = masks, coeffs = coeffs}
end

-- Every variable any term of `p` holds, as one mask.
function union_of(p)
  local u = 0
  for m in p.masks do u = or14(u, m) end
  return u
end

const ZERO_POLY = {masks = {}, coeffs = {}}
const ONE_POLY = {masks = {0}, coeffs = {1}}

function variable(index)
  if index >= VARIABLE_LIMIT then fail("variable " .. index .. " is past the last") end
  return {masks = {POW2[index + 1]}, coeffs = {1}}
end

-- p + sign * q.
function added(p, q, sign)
  for i = 1, #p.masks do
    local k = p.masks[i] + 1
    SUMS[k] = SUMS[k] + p.coeffs[i]
  end
  for i = 1, #q.masks do
    local k = q.masks[i] + 1
    SUMS[k] = SUMS[k] + sign * q.coeffs[i]
  end
  return from_sums(or14(union_of(p), union_of(q)))
end

function plus(p, q) return added(p, q, 1) end
function minus(p, q) return added(p, q, -1) end

-- Every pair of terms, masks ORed and coefficients multiplied, summed by
-- mask. The OR of a pair is two reads of OR7, one a 7-bit half, so q's
-- halves are split once, before the pairs.
function times(p, q)
  local q_high = {}
  local q_low = {}
  for m in q.masks do
    push(q_high, m // HALF + 1)
    push(q_low, m % HALF + 1)
  end
  local q_coeffs = q.coeffs
  local n = #q_coeffs
  for i = 1, #p.masks do
    local a = p.masks[i]
    local high = (a // HALF) * HALF
    local low = (a % HALF) * HALF
    local c = p.coeffs[i]
    for j = 1, n do
      local k = OR7[high + q_high[j]] * HALF + OR7[low + q_low[j]] + 1
      SUMS[k] = SUMS[k] + c * q_coeffs[j]
    end
  end
  return from_sums(or14(union_of(p), union_of(q)))
end

-- The value when the variables in `ones` are 1 and the rest 0.
function eval_at(p, ones)
  local sum = 0
  for i = 1, #p.masks do
    local m = p.masks[i]
    if and14(m, ones) == m then sum = sum + p.coeffs[i] end
  end
  return sum
end

-- The value at every point of `count` variables, point `ones` at slot
-- ones + 1: the coefficients summed over subsets, one variable at a time
-- (the zeta transform).
function values(p, count)
  local size = POW2[count + 1]
  local out = zeros(size)
  for i = 1, #p.masks do out[p.masks[i] + 1] = p.coeffs[i] end
  for index = 1, count do
    local w = POW2[index]
    for base = 0, size - 1, 2 * w do
      for j = base + w + 1, base + 2 * w do out[j] = out[j] + out[j - w] end
    end
  end
  return out
end

function degree(p)
  local most = 0
  for m in p.masks do most = max(most, POP[m + 1]) end
  return most
end

function max_abs_coeff(p)
  local most = 0
  for c in p.coeffs do most = max(most, abs(c)) end
  return most
end

-- ------------------------------------------------------------ the stepper
--
-- One step as four polynomials in six variables: hb, lb, halted, accepted,
-- op_hb, op_lb. NOT x is 1 - x, x AND y is x·y, x OR y is x + y - x·y.

function negation(x) return minus(ONE_POLY, x) end
function either(x, y) return minus(plus(x, y), times(x, y)) end

function any_of(polys)
  local out = ZERO_POLY
  for p in polys do out = either(out, p) end
  return out
end

function next_state(hb, lb, halted, accepted, op_hb, op_lb)
  local is0 = times(negation(hb), negation(lb))
  local is1 = times(negation(hb), lb)
  local is2 = times(hb, negation(lb))
  local is3 = times(hb, lb)

  local runs_pass = either(times(negation(op_hb), negation(op_lb)), halted)
  local runs_check = times(times(negation(op_hb), op_lb), negation(halted))
  local runs_decr = times(times(op_hb, negation(op_lb)), negation(halted))
  local runs_mod2 = times(times(op_hb, op_lb), negation(halted))

  -- What each op does to each state: the AX it moves to, or an accept or
  -- a halt.
  local pass_to = {times(is1, runs_pass), times(is2, runs_pass), times(is3, runs_pass)}
  local check_to = {times(is1, runs_check), times(is2, runs_check), times(is3, runs_check)}
  local decr_to = {times(is2, runs_decr), times(is3, runs_decr)}
  local mod2_to = times(either(is3, is1), runs_mod2)
  local check_accepts = times(is0, runs_check)
  local decr_halts = times(is0, runs_decr)

  -- A polynomial's canonical form is unique, so the order the ORs are
  -- taken in doesn't matter.
  local becomes1 = any_of({pass_to[1], check_to[1], decr_to[1], mod2_to})
  local becomes2 = any_of({pass_to[2], check_to[2], decr_to[2]})
  local becomes3 = any_of({pass_to[3], check_to[3]})
  return {
    hb = either(becomes3, becomes2),
    lb = either(becomes3, becomes1),
    halted = either(halted, decr_halts),
    accepted = either(accepted, check_accepts),
  }
end

const STEP = next_state(variable(0), variable(1), variable(2), variable(3), variable(4), variable(5))

-- Each step polynomial's value at all 64 of its points, so a step of the
-- stepper is four reads.
const STEP_TABLES = {values(STEP.hb, 6), values(STEP.lb, 6), values(STEP.halted, 6), values(STEP.accepted, 6)}

function bit_of(value)
  if value == 0 or value == 1 then return value end
  fail("a step polynomial gave " .. value .. ", not 0 or 1")
end

-- Python's `step`: the step polynomials at one state and op.
function stepper_step(s, op)
  local slot = s.ax // 2 + 2 * (s.ax % 2) + 4 * s.halted + 8 * s.accepted + 16 * (op // 2) + 32 * (op % 2) + 1
  return {
    ax = 2 * bit_of(STEP_TABLES[1][slot]) + bit_of(STEP_TABLES[2][slot]),
    halted = bit_of(STEP_TABLES[3][slot]),
    accepted = bit_of(STEP_TABLES[4][slot]),
  }
end

function stepper_run(program, input)
  local s = {ax = input, halted = 0, accepted = 0}
  for op in program do s = stepper_step(s, op) end
  return s
end

-- --------------------------------------------------------- find_solutions

function find_solutions()
  local programs = {}
  for y = 1, LANGUAGE_COUNT do push(programs, {}) end
  for n = 0, PROGRAM_COUNT - 1 do push(programs[accepted_code(disassemble(n)) + 1], n) end
  for y = 0, LANGUAGE_COUNT - 1 do
    if #programs[y + 1] == 0 then fail("no program accepts language " .. y) end
  end
  for y = 0, LANGUAGE_COUNT - 1 do
    local lang = language_of(y)
    print(lang_text(lang) .. " is solved by " .. #programs[y + 1] .. " possible program")
    print("See an example program below.")
    print("   it accepts " .. lang_text(lang))
    print("   it rejects " .. lang_text(complement_of(lang)))
    print("--")
    local example = disassemble(programs[y + 1][1])
    for op in example do print(OP_NAMES[op + 1] .. " " .. OP_COMMENTS[op + 1]) end
    print("--")
    print("")
    -- Python's assert: the stepper accepts exactly the language.
    for input = 0, INPUT_COUNT - 1 do
      local accepted = stepper_run(example, input).accepted == 1
      if accepted ~= has_item(lang, input) then fail("the stepper disagrees on input " .. input .. " of language " .. y) end
    end
  end
end

-- ------------------------------------------------------------ composition
--
-- The step polynomials substituted into themselves: after step k the state
-- is four polynomials in 14 variables, the input's two bits (0, 1) and each
-- instruction's two (2k, 2k + 1).

-- The product of the replacements over each monomial of six variables,
-- made once a step and kept by mask (slot mask + 1); MADE says which.
const PRODUCTS = zeros(64)
const MADE = zeros(64)

function product_of(mask, replacements)
  if MADE[mask + 1] == 1 then return PRODUCTS[mask + 1] end
  local product = ONE_POLY
  if mask > 0 then
    local top = 5
    while POW2[top + 1] > mask do top = top - 1 end
    product = times(product_of(mask - POW2[top + 1], replacements), replacements[top + 1])
  end
  PRODUCTS[mask + 1] = product
  MADE[mask + 1] = 1
  return product
end

function substituted(p, replacements)
  local width = 0
  for r in replacements do width = or14(width, union_of(r)) end
  -- Every product first: a product is summed in SUMS too.
  for m in p.masks do product_of(m, replacements) end
  for i = 1, #p.masks do
    local product = product_of(p.masks[i], replacements)
    local c = p.coeffs[i]
    for j = 1, #product.masks do
      local k = product.masks[j] + 1
      SUMS[k] = SUMS[k] + c * product.coeffs[j]
    end
  end
  return from_sums(width)
end

function after_step(before, index)
  for m = 1, 64 do MADE[m] = 0 end
  local replacements = {before.hb, before.lb, before.halted, before.accepted, variable(2 * index), variable(2 * index + 1)}
  return {
    hb = substituted(STEP.hb, replacements),
    lb = substituted(STEP.lb, replacements),
    halted = substituted(STEP.halted, replacements),
    accepted = substituted(STEP.accepted, replacements),
  }
end

-- The stepper's halted by its rule: rejected, or accepted with a `decr`
-- after the accepting `zero`.
function halts_by_rule(program, input)
  local m = {ax = input, ending = RUNNING}
  local halts = 0
  for op in program do
    if m.ending == ACCEPTED and op == DECR then
      halts = 1
    else
      m = machine_step(m, op)
    end
  end
  if m.ending == REJECTED then return 1 end
  return halts
end

-- The four final polynomials against the machine at every point.
function proof(final)
  local hb = values(final.hb, VARIABLE_LIMIT)
  local lb = values(final.lb, VARIABLE_LIMIT)
  local halted = values(final.halted, VARIABLE_LIMIT)
  local accepted = values(final.accepted, VARIABLE_LIMIT)
  local differ = 0
  local accepts = 0
  local unlike = 0
  for ones = 0, SIZE - 1 do
    local input = 2 * (ones % 2) + (ones // 2) % 2
    local program = {}
    local rest = ones // 4
    for i = 1, PROGRAM_LENGTH do
      push(program, 2 * (rest % 2) + (rest // 2) % 2)
      rest = rest // 4
    end
    local machine = machine_run(program, input)
    local stepper = stepper_run(program, input)
    local at = ones + 1
    local want_accepted = 0
    if machine.ending == ACCEPTED then want_accepted = 1 end
    local point = input // 2 + 2 * (input % 2)
    for i = 1, PROGRAM_LENGTH do
      local op = program[i]
      point = point + (op // 2 + 2 * (op % 2)) * POW2[2 * i + 1]
    end
    local agrees = accepted[at] == want_accepted
      and hb[at] == machine.ax // 2
      and lb[at] == machine.ax % 2
      and halted[at] == stepper.halted
      and halted[at] == halts_by_rule(program, input)
      and point == ones
      and (ones % 61 ~= 0 or eval_at(final.accepted, ones) == accepted[at])
    if not agrees then differ = differ + 1 end
    accepts = accepts + want_accepted
    local halted_by_machine = 1
    if machine.ending == RUNNING then halted_by_machine = 0 end
    if halted[at] ~= halted_by_machine then unlike = unlike + 1 end
  end
  return "proof: " .. SIZE .. " points, " .. differ .. " differ, " .. accepts .. " accepted, " .. unlike .. " accepted with no halt"
end

function terms(p) return #p.masks end

function composition(count)
  print("step  hb  lb  halted  accepted")
  local state = {hb = variable(0), lb = variable(1), halted = ZERO_POLY, accepted = ZERO_POLY}
  for index = 1, count do
    state = after_step(state, index)
    print(index .. "  " .. terms(state.hb) .. "  " .. terms(state.lb) .. "  " .. terms(state.halted) .. "  " .. terms(state.accepted))
  end
  for name in {"hb", "lb", "halted", "accepted"} do
    local p = state[name]
    print(name .. ": " .. terms(p) .. " terms, degree " .. degree(p) .. ", max |coeff| " .. max_abs_coeff(p))
  end
  if count == PROGRAM_LENGTH then
    print(proof(state))
  else
    print("proof: needs all " .. PROGRAM_LENGTH .. " steps")
  end
end

if part ~= "all" and part ~= "search" and part ~= "composition" then fail("part=" .. part .. ": all, search or composition") end
if steps < 1 or steps > PROGRAM_LENGTH then fail("steps=" .. steps .. ": 1 to " .. PROGRAM_LENGTH) end
if part ~= "composition" then find_solutions() end
if part ~= "search" then composition(steps) end
