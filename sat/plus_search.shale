-- sat/plus_search.shale: rocsat searching for Nibble++ programs, the
-- expensive part, which build.shale does not run. For each language W of
-- CASES, at its census length L (src/census.c's shortest):
--
--   - the search CNF at L lines (`plus_sat search W L`: the program bits
--     shared by 16 runs, one per input, each held to W's want bit) should be
--     SAT: rocsat found an L-line program for W. The model is checked by
--     `rocsat check` and `drat model`, and its program on the interpreter.
--   - at L - 1 lines it should be UNSAT, with a DRAT proof that src/drat.c
--     checks: a proof that L is the shortest, independent of the census.
--
-- Each solve runs at nice 19 with a timeout of TIMEOUT_MS; a timeout is a
-- result, recorded as one. The results go to sat/plus/search.txt, a table
-- rewritten after every case, so a run cut short keeps what it found. It
-- fails when an answer is wrong (a SAT below the census length, an UNSAT at
-- it, a check refused), never on a timeout, rocsat's or the DRAT check's
-- (600 s, sat/plus_rocsat.shale's plus_drat). From the repository's root:
--
--   shale sat/plus_search.shale
--
-- It can take about 2 x TIMEOUT_MS a case; the 11 cases took 142 s in all
-- on the box (2026-11-26), the two proof checks at 27 and 28 lines 65 s.
-- budget: steps=400000000 read_bytes=4000000000 changes=100000 change_bytes=4000000000 arena_bytes=1500000000 programs=1000

use("./plus_rocsat.shale")

const RESULTS = "sat/plus/search.txt"
const TIMEOUT_MS = 120000
-- Spread across the lengths: {0}, {0, 1}, {2, 3, 6, 7, 10, 11, 14, 15},
-- the top half {8..15}, {15}, then languages at 12, 16, 20 and 24 lines,
-- and two of the 42 hardest, at 27 and 28.
const CASES = {1, 3, 52428, 65280, 32768, 95, 383, 1535, 6143, 38910, 49151}

-- A language's members, `{0, 2, 3}`.
function members(w)
  local in_it = {}
  local place = 1
  for n = 0, 15 do
    if (w // place) % 2 == 1 then push(in_it, "" .. n) end
    place = place * 2
  end
  return "{" .. join(in_it, ", ") .. "}"
end

function secs(ms)
  return (ms // 1000) .. "." .. ((ms % 1000) // 100) .. " s"
end

-- A solve's cell: its time, or the timeout.
function timed(row)
  if row.verdict == "timeout" then return "timeout (" .. secs(TIMEOUT_MS) .. ")" end
  return secs(row.ms) .. " (cpu " .. secs(row.cpu_ms) .. ")"
end

local t = plus_tools(arg("rocsat", "build:rocsat/src/rocsat"), "out/sat/plus_search")
mkdir("sat/plus")
local census = plus_census(t, CASES)
local rows = {}
local wrong = 0
for w in CASES do
  local L = census["" .. w].length
  local at = plus_search(t, w, L, TIMEOUT_MS)
  local sat_ok = at.verdict == "timeout" or (at.verdict == "SAT" and at.checked)
  local row = {W = w, set = members(w), L = L, sat = at.verdict .. ", " .. timed(at), program = at.program, unsat = "-", proof = "-", checked = "-"}
  if at.verdict == "SAT" then row.checked = at.checked and "model yes" or "model NO" end
  if not sat_ok then
    print("WRONG: W=" .. w .. " at " .. L .. " lines: " .. at.verdict .. ", " .. at.line)
    wrong = wrong + 1
  end
  if L > 0 then
    local below = plus_search(t, w, L - 1, TIMEOUT_MS)
    row.unsat = below.verdict .. ", " .. timed(below)
    if below.verdict == "UNSAT" then
      row.proof = below.proof_bytes .. " bytes, checked in " .. secs(below.check_ms)
      row.checked = row.checked .. ", proof " .. (below.checked and "yes" or "NO")
      if below.check_timed_out then
        row.proof = below.proof_bytes .. " bytes, check timed out at " .. secs(below.check_ms)
        row.checked = row.checked .. ", proof unchecked"
      elseif not below.checked then
        print("WRONG: W=" .. w .. "'s proof at " .. (L - 1) .. " lines: " .. below.line)
        wrong = wrong + 1
      end
    elseif below.verdict == "SAT" then
      print("WRONG: W=" .. w .. " is SAT at " .. (L - 1) .. " lines, below the census: " .. below.program)
      wrong = wrong + 1
    end
  end
  push(rows, row)
  print(w .. " " .. members(w) .. " L=" .. L .. ": " .. row.sat .. "; L-1: " .. row.unsat .. "; " .. row.proof)
  replace(RESULTS, "Nibble++ search: rocsat at the census length L (SAT) and at L - 1 (UNSAT, its DRAT proof checked by src/drat.c); nice 19, timeout " .. secs(TIMEOUT_MS) .. " a solve.\n\n" .. table(rows, {"W", "set", "L", "sat", "unsat", "proof", "checked", "program"}) .. "\n")
  yield()
end
print(read(RESULTS))
if wrong > 0 then fail(wrong .. " wrong answer(s)") end
print("plus_search: " .. #rows .. " languages; " .. RESULTS .. " written")
