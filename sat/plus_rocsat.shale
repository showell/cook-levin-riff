-- sat/plus_rocsat.shale: the library sat/plus.shale and sat/plus_search.shale
-- share, rocsat on Nibble++'s CNF (src/plus_sat.c, through out/tcc/plus_sat)
-- with src/drat.c checking what it answers. Each function takes `t`, the
-- tools: {rocsat, plus, drat, out}, Shale paths of rocsat, the plus_sat and
-- drat binaries, and the folder the CNFs, models and proofs go to.

const PLUS_WANT_RAN = "plus: plus_sat and drat, just compiled by this script"
const PLUS_WANT_ROCSAT = "plus: rocsat, built in build:rocsat from its pinned nightly"

-- Compiles plus_sat and drat with tcc into out/tcc; gives the tools.
function plus_tools(rocsat, out)
  if not exists(rocsat) then fail("rocsat is not built at " .. rocsat .. ": see README.md, \"SAT\", or give rocsat=PATH") end
  mkdir("out/tcc")
  mkdir(out)
  must(run({"tcc", "-Wall", "-Werror", "-o", real("out/tcc") .. "/plus_sat", "src/plus_sat_main.c"}, {timeout_ms = 60000, tail = 20}))
  must(run({"tcc", "-Wall", "-Werror", "-o", real("out/tcc") .. "/drat", "src/drat_main.c"}, {timeout_ms = 60000, tail = 20}))
  return {rocsat = rocsat, plus = "out/tcc/plus_sat", drat = "out/tcc/drat", out = out}
end

-- plus_sat's stdout for `args`.
function plus_says(t, args)
  local argv = {real(t.plus)}
  for a in args do push(argv, a) end
  return must(run(argv, {timeout_ms = 60000, whole = 8000000, want = PLUS_WANT_RAN})).out
end

-- The census's line for each language: {lang, length, ops}, by lang.
function plus_census(t, langs)
  local args = {"census"}
  for w in langs do push(args, "" .. w) end
  local by = {}
  for l in lines(plus_says(t, args)) do
    local w = words(l)
    if #w == 3 then by[w[1]] = {lang = tonumber(w[1]), length = tonumber(w[2]), ops = w[3]} end
  end
  return by
end

-- rocsat on a CNF file (a DRAT proof to `drat` when given), niced, within
-- `timeout_ms`: {verdict = "SAT" | "UNSAT" | "timeout", ms, cpu_ms, out,
-- stats}, a timeout being a result.
function plus_solve(t, cnf, drat, timeout_ms)
  local argv = {real(t.rocsat), "solve", real(cnf)}
  if drat ~= nil then push(argv, real(drat)) end
  local r = run(argv, {timeout_ms = timeout_ms, whole = 400000, want = PLUS_WANT_ROCSAT, nice = 19})
  local code = get(r, "code", -1)
  local stats = re_find(r.out, "(?:^|\n)c (conflicts=[^\n]*)")
  local said = {ms = r.ms, cpu_ms = r.cpu_ms, out = r.out, stats = ""}
  if stats ~= nil then said.stats = stats.group end
  if code == 10 and find(r.out, "s SATISFIABLE") ~= nil then
    said.verdict = "SAT"
  elseif code == 20 and find(r.out, "s UNSATISFIABLE") ~= nil then
    said.verdict = "UNSAT"
  elseif not has_key(r, "code") and r.ended == "timeout" then
    said.verdict = "timeout"
  else
    print(r.out)
    fail("rocsat on " .. cnf .. ": " .. r.ended .. ", exit " .. code)
  end
  return said
end

-- The values rocsat's `v` lines give variables 1..n: a list of 0s and 1s.
function plus_model_bits(out, n)
  local bits = {}
  for v = 1, n do push(bits, -1) end
  for l in re_lines(out, "^v ") do
    for w in words(l.text) do
      local x = parse_int(w)
      if x ~= nil and x ~= 0 and abs(x) <= n then
        if x > 0 then bits[x] = 1 else bits[-x] = 0 end
      end
    end
  end
  for v = 1, n do
    if bits[v] < 0 then fail("rocsat's model leaves variable " .. v .. " out") end
  end
  return bits
end

-- A model's k-line program, op names joined by commas.
function plus_ops_of(bits, k)
  local names = {"half", "zero", "decr", "mod2"}
  local ops = {}
  for i = 1, k do push(ops, names[2 * bits[2 * i - 1] + bits[2 * i] + 1]) end
  if #ops == 0 then return "-" end
  return join(ops, ",")
end

-- The checker on a CNF and a proof (`check`) or a solver's answer
-- (`model`): {ok, line, ms, timed_out}, a check past 600 s a timeout.
function plus_drat(t, what, cnf, file)
  local r = run({real(t.drat), what, real(cnf), real(file)}, {timeout_ms = 600000, tail = 3, want = PLUS_WANT_RAN, nice = 19})
  return {ok = get(r, "code", -1) == 0, line = trim(r.out), ms = r.ms, timed_out = not has_key(r, "code") and r.ended == "timeout"}
end

-- One search case: language `w` at `k` lines. SAT is checked three ways
-- (rocsat check, drat model, and the program on the interpreter); UNSAT
-- by its DRAT proof. Gives {verdict, ms, cpu_ms, stats, program, checked,
-- line, proof_bytes, check_ms}, `checked` true when every check passed,
-- false for a timeout; `check_ms` is the DRAT check's time, and
-- `check_timed_out` true when it ran past its 600 s.
function plus_search(t, w, k, timeout_ms)
  local name = w .. "-len" .. k
  local cnf = t.out .. "/" .. name .. ".cnf"
  replace(cnf, plus_says(t, {"search", "" .. w, "" .. k}))
  local drat = t.out .. "/" .. name .. ".drat"
  if exists(drat) then remove(drat) end
  local s = plus_solve(t, cnf, drat, timeout_ms)
  local row = {verdict = s.verdict, ms = s.ms, cpu_ms = s.cpu_ms, stats = s.stats, program = "", checked = false, line = "", proof_bytes = 0, check_ms = 0, check_timed_out = false}
  if s.verdict == "SAT" then
    local model = t.out .. "/" .. name .. ".model"
    replace(model, s.out)
    local ops = plus_ops_of(plus_model_bits(s.out, 2 * k), k)
    row.program = ops
    local checked = run({real(t.rocsat), "check", real(cnf), real(model)}, {timeout_ms = 60000, whole = 4000, want = PLUS_WANT_ROCSAT})
    local by_drat = plus_drat(t, "model", cnf, model)
    local decides = run({real(t.plus), "decides", "" .. w, ops}, {timeout_ms = 60000, tail = 2, want = PLUS_WANT_RAN})
    row.checked = get(checked, "code", -1) == 0 and trim(checked.out) == "c model ok" and by_drat.ok and get(decides, "code", -1) == 0
    row.line = "rocsat check: " .. trim(checked.out) .. "; drat model: " .. (by_drat.ok and "ok" or by_drat.line) .. "; the interpreter: decides " .. trim(decides.out)
  elseif s.verdict == "UNSAT" then
    if not exists(drat) then fail("rocsat said UNSAT on " .. cnf .. " and wrote no proof") end
    row.proof_bytes = stat(drat).size
    local said = plus_drat(t, "check", cnf, drat)
    row.checked = said.ok
    row.line = said.line
    row.check_ms = said.ms
    row.check_timed_out = said.timed_out
  end
  return row
end
