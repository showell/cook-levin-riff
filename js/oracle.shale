-- budget: steps=40000000
-- js/oracle.shale: js/cook_levin.js run three ways, each run's output held
-- byte for byte to the goldens. From the repository's root:
--
--   shale js/oracle.shale
--
-- The three runners, niced and one at a time (the box has 2 cores):
--
-- - node, the program as written: tests/golden/find_solutions.txt, then
--   roc/golden/composition.txt, exactly.
-- - js-vm, roc-js-interpreter's bytecode VM (its release build), on the
--   program's text, held to the same goldens. It is the slow one: about 80
--   s, of 15 million of its steps (its budget is 200 million).
-- - js-x86, roc-js-interpreter's x86-64 compiler: the program compiled to a
--   static executable under build:cook-levin/js, run under GNU time for its
--   peak memory (compiled programs have no collector yet), and held to the
--   same goldens as node.
--
-- One line a runner, with its time. The run fails unless all three pass.
--
-- **The one cross-repo piece:** the VM and the compiler are built from the
-- roc-js-interpreter checkout beside this one (`repos:roc-js-interpreter`),
-- by its own tools/roc_build.shale, which reuses a build its cache holds.
-- With no such checkout the run stops, saying so.

const WHO = "js/oracle.shale"
const PROGRAM = "js/cook_levin.js"
const SIBLING = "repos:roc-js-interpreter"
const WANT_NODE = "node: the first oracle for the JavaScript port"
const WANT_TIME = "js-oracle: GNU time reads the executable's peak memory, which Shale's run doesn't report"
const WANT_TOOL = "js-oracle: roc-js-interpreter's VM and compiler, built in its checkout"
const WANT_BINARY = "js-oracle: the executable js-x86 wrote, run to check it"

-- Every byte from 0 to 255 in order, to turn the compiler's hex back into
-- bytes: a copy of roc-js-interpreter's x86/executables.shale's BYTES and
-- bytes_of_hex, which a library here can't load (it calls that repo's
-- prelude).
const BYTES = "\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f\x20\x21\x22\x23\x24\x25\x26\x27\x28\x29\x2a\x2b\x2c\x2d\x2e\x2f\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39\x3a\x3b\x3c\x3d\x3e\x3f\x40\x41\x42\x43\x44\x45\x46\x47\x48\x49\x4a\x4b\x4c\x4d\x4e\x4f\x50\x51\x52\x53\x54\x55\x56\x57\x58\x59\x5a\x5b\x5c\x5d\x5e\x5f\x60\x61\x62\x63\x64\x65\x66\x67\x68\x69\x6a\x6b\x6c\x6d\x6e\x6f\x70\x71\x72\x73\x74\x75\x76\x77\x78\x79\x7a\x7b\x7c\x7d\x7e\x7f\x80\x81\x82\x83\x84\x85\x86\x87\x88\x89\x8a\x8b\x8c\x8d\x8e\x8f\x90\x91\x92\x93\x94\x95\x96\x97\x98\x99\x9a\x9b\x9c\x9d\x9e\x9f\xa0\xa1\xa2\xa3\xa4\xa5\xa6\xa7\xa8\xa9\xaa\xab\xac\xad\xae\xaf\xb0\xb1\xb2\xb3\xb4\xb5\xb6\xb7\xb8\xb9\xba\xbb\xbc\xbd\xbe\xbf\xc0\xc1\xc2\xc3\xc4\xc5\xc6\xc7\xc8\xc9\xca\xcb\xcc\xcd\xce\xcf\xd0\xd1\xd2\xd3\xd4\xd5\xd6\xd7\xd8\xd9\xda\xdb\xdc\xdd\xde\xdf\xe0\xe1\xe2\xe3\xe4\xe5\xe6\xe7\xe8\xe9\xea\xeb\xec\xed\xee\xef\xf0\xf1\xf2\xf3\xf4\xf5\xf6\xf7\xf8\xf9\xfa\xfb\xfc\xfd\xfe\xff"
const HEX_DIGITS = "0123456789abcdef"

function bytes_of_hex(spaced)
  if not re_match(spaced, "^([0-9a-f]{2}( [0-9a-f]{2})*)?$") then fail(WHO .. ": js-x86 printed something that is not spaced lowercase hex: " .. sub(spaced, 1, 200)) end
  local hex = re_replace(spaced, " ", "")
  local parts = {}
  local i = 1
  while i < #hex do
    local n = (find(HEX_DIGITS, sub(hex, i, i)) - 1) * 16 + find(HEX_DIGITS, sub(hex, i + 1, i + 1))
    push(parts, sub(BYTES, n, n))
    i = i + 2
  end
  return join(parts, "")
end

-- The real path of roc-js-interpreter's command `name`, built from `app` in
-- `mode` by its tools/roc_build.shale (reused when its cache holds it).
function sibling_build(app, name, mode)
  if not exists(SIBLING .. "/tools/roc_build.shale") then
    fail(WHO .. ": no roc-js-interpreter checkout at " .. SIBLING .. " (beside this one): the VM and the compiler are built from it")
  end
  local r = run({"shale", "tools/roc_build.shale", "--args-stdin"}, {cwd = SIBLING, timeout_ms = 600000, tail = 30, nice = 19, want = WANT_TOOL, stdin = "app=" .. app .. "\nname=" .. name .. "\nmode=" .. mode .. "\n"})
  local exe = nil
  for l in lines(r.out) do
    if starts_with(l, "exe\t") then exe = sub(l, 5) end
  end
  if r.code ~= 0 or exe == nil then fail(WHO .. ": roc-js-interpreter's roc_build.shale could not build " .. name .. " " .. mode .. ":\n" .. trim(r.out)) end
  return exe
end

-- PASS when `got` is `want`, else where they first part.
function verdict(got, want)
  if got == want then return "PASS" end
  local g = lines(got)
  local w = lines(want)
  for i = 1, #w do
    if g[i] ~= w[i] then return "FAIL at line " .. i .. ": got `" .. sub(get(g, i, "(nothing)"), 1, 100) .. "`, want `" .. sub(w[i], 1, 100) .. "`" end
  end
  return "FAIL: " .. #g .. " lines, the golden " .. #w
end

function report(name, r, want, extra)
  local v = verdict(r.out, want)
  if r.ended ~= "exit" or r.code ~= 0 then v = "FAIL: ended " .. r.ended .. " " .. get(r, "code", -1) .. ": " .. sub(trim(r.out), -300) end
  print(name .. ": " .. v .. ", " .. r.ms .. " ms (" .. r.cpu_ms .. " ms CPU)" .. extra)
  return starts_with(v, "PASS")
end

function main()
  local search = read("tests/golden/find_solutions.txt")
  local composed = read("roc/golden/composition.txt")
  local want = search .. composed
  local text = read(PROGRAM)

  local js_x86 = sibling_build("x86/roc/JsToX86.roc", "js-x86", "dev")
  local js_vm = sibling_build("js/roc/JsVm.roc", "js-vm", "speed")
  local dir = "build:cook-levin/js"
  mkdir(dir)

  local passed = 0

  local node = run({"node", real(PROGRAM)}, {timeout_ms = 120000, whole = 200000, nice = 19, want = WANT_NODE})
  if report("node", node, want, "") then passed = passed + 1 end

  local vm = run({js_vm, text}, {timeout_ms = 400000, whole = 200000, nice = 19, want = WANT_TOOL})
  if report("js-vm (release)", vm, want, "") then passed = passed + 1 end

  local made = run({js_x86, text}, {timeout_ms = 120000, whole = 8000000, nice = 19, want = WANT_TOOL})
  if made.code ~= 0 then fail(WHO .. ": js-x86 refused " .. PROGRAM .. ": " .. sub(trim(made.out), -500)) end
  local binary = bytes_of_hex(made.out)
  local path = dir .. "/cook_levin"
  replace(path, binary)
  must(run({"chmod", "755", real(path)}, {timeout_ms = 10000, whole = 4000}))
  local x = run({"/usr/bin/time", "-f", "peak %M", real(path)}, {timeout_ms = 120000, whole = 200000, nice = 19, want = WANT_TIME})
  local peak = re_find(x.out, "peak ([0-9]+)\n$")
  if peak == nil then fail(WHO .. ": no peak memory from GNU time: " .. sub(x.out, -300)) end
  x.out = sub(x.out, 1, #x.out - #("peak " .. peak.group .. "\n"))
  if report("js-x86", x, want, ", " .. #binary .. " bytes, peak " .. peak.group .. " KiB") then passed = passed + 1 end

  print("js/oracle: " .. passed .. " of 3 passed")
  if passed ~= 3 then fail(WHO .. ": " .. (3 - passed) .. " runner(s) failed") end
end

main()
